@{
    ViewData["Title"] = "Subscribe to Newsletter";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-envelope mr-2"></i>
                        Subscribe to Our Newsletter
                    </h4>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">
                        Stay updated with our latest products, exclusive offers, and news. 
                        We promise not to spam you!
                    </p>
                    
                    <form id="newsletterForm">
                        <div class="form-group">
                            <label for="email">Email Address *</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="firstName">First Name</label>
                            <input type="text" class="form-control" id="firstName" name="firstName">
                        </div>
                        
                        <div class="form-group">
                            <label for="lastName">Last Name</label>
                            <input type="text" class="form-control" id="lastName" name="lastName">
                        </div>
                        
                        <div class="form-check mb-3">
                            <input type="checkbox" class="form-check-input" id="agreeTerms" required>
                            <label class="form-check-label" for="agreeTerms">
                                I agree to receive marketing emails and understand I can unsubscribe at any time.
                            </label>
                        </div>
                        
                        <button type="submit" class="btn btn-primary btn-block">
                            <i class="fas fa-paper-plane mr-2"></i>
                            Subscribe Now
                        </button>
                    </form>
                    
                    <div id="result" class="mt-3"></div>
                </div>
                <div class="card-footer text-muted text-center">
                    <small>
                        <i class="fas fa-shield-alt mr-1"></i>
                        Your privacy is important to us. We'll never share your email.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#newsletterForm').on('submit', function(e) {
            e.preventDefault();
            
            const email = $('#email').val();
            const firstName = $('#firstName').val();
            const lastName = $('#lastName').val();
            
            if (!$('#agreeTerms').is(':checked')) {
                showResult('Please agree to receive marketing emails.', 'danger');
                return;
            }
            
            $.post('/Newsletter/Subscribe', {
                email: email,
                firstName: firstName,
                lastName: lastName
            })
            .done(function(response) {
                if (response.success) {
                    showResult(response.message, 'success');
                    $('#newsletterForm')[0].reset();
                } else {
                    showResult(response.message, 'warning');
                }
            })
            .fail(function() {
                showResult('An error occurred. Please try again.', 'danger');
            });
        });
        
        function showResult(message, type) {
            $('#result').html(`
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="close" data-dismiss="alert">
                        <span>&times;</span>
                    </button>
                </div>
            `);
        }
    </script>
}

<style>
    .card {
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border: none;
    }
    
    .card-header {
        border-bottom: none;
    }
    
    .form-control:focus {
        border-color: #e83e8c;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
    }
    
    .btn-primary {
        background: linear-gradient(45deg, #e83e8c, #0056b3);
        border: none;
    }
    
    .btn-primary:hover {
        background: linear-gradient(45deg, #0056b3, #004085);
        transform: translateY(-1px);
    }
</style>
