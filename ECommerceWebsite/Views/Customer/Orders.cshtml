@model IEnumerable<ECommerceWebsite.Models.Order>
@using System.Globalization
@using System.Text.Json
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Title"];
}

<div class="container py-4 orders-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <h2 class="mb-2 mb-md-0"><i class="fas fa-shopping-cart me-2 text-primary"></i>@Localizer["OrdersHeading"]</h2>
        <div class="d-flex gap-2">
            <a asp-action="Dashboard" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>@Localizer["Dashboard"]</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="fas fa-shopping-bag me-1"></i>@Localizer["Shop"]</a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-3">
            @foreach (var order in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm order-card">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap">
                            <div class="me-3">
                                <h6 class="mb-0">@Localizer["OrderNumber", order.OrderNumber]</h6>
                                <small class="text-muted">@Localizer["PlacedOn", order.OrderDate.ToString("D", CultureInfo.CurrentCulture)]</small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                @switch (order.Status)
                                {
                                    case OrderStatus.Pending:
                                        <span class="badge bg-warning">@Localizer["Pending"]</span>
                                        break;
                                    case OrderStatus.Processing:
                                        <span class="badge bg-info">@Localizer["Processing"]</span>
                                        break;
                                    case OrderStatus.Shipped:
                                        <span class="badge bg-primary">@Localizer["Shipped"]</span>
                                        break;
                                    case OrderStatus.Delivered:
                                        <span class="badge bg-success">@Localizer["Delivered"]</span>
                                        break;
                                    case OrderStatus.Cancelled:
                                        <span class="badge bg-danger">@Localizer["Cancelled"]</span>
                                        break;
                                }
                                <span class="badge bg-light text-dark">@order.TotalAmount.ToString("C", CultureInfo.CurrentCulture)</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-8">
                                    <h6 class="mb-2">@Localizer["Items", order.OrderItems.Count()]</h6>
                                    <div class="row g-2">
                                        @foreach (var item in order.OrderItems.Take(3))
                                        {
                                            <div class="col-md-4 col-6">
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                                    {
                                                        <img src="@item.Product.ImageUrl" alt="@item.Product.GetLocalizedName()" class="rounded me-2" style="width: 50px; height: 50px; object-fit: cover;">
                                                    }
                                                    <div>
                                                        <small class="fw-bold d-block">@item.Product.GetLocalizedName()</small>
                                                        <small class="text-muted">@Localizer["Quantity", item.Quantity]</small>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        @if (order.OrderItems.Count() > 3)
                                        {
                                            <div class="col-md-4 col-6"><small class="text-muted">@Localizer["MoreItems", order.OrderItems.Count() - 3]</small></div>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                    @if (order.ShippedDate.HasValue)
                                    {
                                        <small class="text-muted d-block">@Localizer["ShippedOn", order.ShippedDate.Value.ToString("D", CultureInfo.CurrentCulture)]</small>
                                    }
                                    @if (order.DeliveredDate.HasValue)
                                    {
                                        <small class="text-success d-block">@Localizer["DeliveredOn", order.DeliveredDate.Value.ToString("D", CultureInfo.CurrentCulture)]</small>
                                    }
                                    <div class="mt-2">
                                        <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye me-1"></i>@Localizer["ViewDetails"]
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="@Localizer["PaginationAria"]" class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Orders" asp-route-page="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
            <h4>@Localizer["NoOrdersTitle"]</h4>
            <p class="text-muted">@Localizer["NoOrdersDescription"]</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="fas fa-shopping-bag me-1"></i>@Localizer["StartShopping"]</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function initRtlToggle(){
            const key = 'rtl_orders_page';
            const resources = { rtlLabel: @Html.Raw(JsonSerializer.Serialize(Localizer["RtlToggleLabel"].Value)) };
            const $root = $('.orders-page');
            const saved = sessionStorage.getItem(key) === '1';
            if (saved) $root.addClass('rtl');
            const id = 'rtl-toggle';
            if (!document.getElementById(id)) {
                $('body').append('<button id="' + id + '" class="btn btn-light border shadow-sm position-fixed" style="bottom:88px;right:16px;z-index:1030">' + resources.rtlLabel + '</button>');
                $('#' + id).on('click', function () {
                    $root.toggleClass('rtl');
                    sessionStorage.setItem(key, $root.hasClass('rtl') ? '1' : '0');
                });
            }
        })();
    </script>
}

<style>
    .order-card { transition: transform .12s ease, box-shadow .12s ease; border-radius: .6rem; }
    .order-card:hover { transform: translateY(-2px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.08) !important; }
    .orders-page h2, .orders-page h6 { letter-spacing: .2px; }

    /* Scoped RTL */
    .orders-page.rtl { direction: rtl; }
    .orders-page.rtl .me-1 { margin-right: 0 !important; margin-left: .25rem !important; }
    .orders-page.rtl .me-2 { margin-right: 0 !important; margin-left: .5rem !important; }
    .orders-page.rtl .me-3 { margin-right: 0 !important; margin-left: 1rem !important; }
    .orders-page.rtl .ms-1 { margin-left: 0 !important; margin-right: .25rem !important; }
    .orders-page.rtl .ms-2 { margin-left: 0 !important; margin-right: .5rem !important; }
    .orders-page.rtl .text-start { text-align: right !important; }
    .orders-page.rtl .text-end { text-align: left !important; }
</style>
