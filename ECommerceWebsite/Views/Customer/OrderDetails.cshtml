@model ECommerceWebsite.Models.Order
@using System.Globalization
@using System.Text.Json
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Title", Model.OrderNumber];
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Localizer["Heading", Model.OrderNumber]</h2>
        <a asp-action="Orders" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>@Localizer["BackToOrders"]
        </a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>@Localizer["OrderInformation"]
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>@Localizer["OrderDateLabel"]</strong> @Model.OrderDate.ToString("D", CultureInfo.CurrentCulture)</p>
                            <p><strong>@Localizer["StatusLabel"]</strong>
                                @switch (Model.Status)
                                {
                                    case OrderStatus.Pending:
                                        <span class="badge bg-warning">@Localizer["Pending"]</span>
                                        break;
                                    case OrderStatus.Processing:
                                        <span class="badge bg-info">@Localizer["Processing"]</span>
                                        break;
                                    case OrderStatus.Shipped:
                                        <span class="badge bg-primary">@Localizer["Shipped"]</span>
                                        break;
                                    case OrderStatus.Delivered:
                                        <span class="badge bg-success">@Localizer["Delivered"]</span>
                                        break;
                                    case OrderStatus.Cancelled:
                                        <span class="badge bg-danger">@Localizer["Cancelled"]</span>
                                        break;
                                }
                            </p>
                            <p><strong>@Localizer["PaymentMethodLabel"]</strong> @Model.PaymentMethod</p>
                            <p><strong>@Localizer["PaymentStatusLabel"]</strong>
                                @switch (Model.PaymentStatus)
                                {
                                    case PaymentStatus.Pending:
                                        <span class="badge bg-warning">@Localizer["Pending"]</span>
                                        break;
                                    case PaymentStatus.Paid:
                                        <span class="badge bg-success">@Localizer["Paid"]</span>
                                        break;
                                    case PaymentStatus.Failed:
                                        <span class="badge bg-danger">@Localizer["Failed"]</span>
                                        break;
                                    case PaymentStatus.Refunded:
                                        <span class="badge bg-info">@Localizer["Refunded"]</span>
                                        break;
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            @if (Model.ShippedDate.HasValue)
                            {
                                <p><strong>@Localizer["ShippedDateLabel"]</strong> @Model.ShippedDate.Value.ToString("D", CultureInfo.CurrentCulture)</p>
                            }
                            @if (Model.DeliveredDate.HasValue)
                            {
                                <p><strong>@Localizer["DeliveredDateLabel"]</strong> @Model.DeliveredDate.Value.ToString("D", CultureInfo.CurrentCulture)</p>
                            }
                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                <p><strong>@Localizer["NotesLabel"]</strong> @Model.Notes</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-box me-2"></i>@Localizer["OrderItems", Model.OrderItems.Count()]
                    </h5>
                </div>
                <div class="card-body">
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="row align-items-center border-bottom py-3">
                            <div class="col-md-2">
                                @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                {
                                    <img src="@item.Product.ImageUrl" alt="@item.Product.GetLocalizedName()"
                                         class="img-fluid rounded" style="max-height: 80px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 80px;">
                                        <i class="fas fa-image text-muted"></i>
                                    </div>
                                }
                            </div>
                            <div class="col-md-4">
                                <h6 class="mb-1">@item.Product.GetLocalizedName()</h6>
                                <small class="text-muted">@item.Product.Category.GetLocalizedName()</small>
                            </div>
                            <div class="col-md-2 text-center">
                                <span class="fw-bold">@item.UnitPrice.ToString("C", CultureInfo.CurrentCulture)</span>
                            </div>
                            <div class="col-md-2 text-center">
                                <span>@Localizer["Quantity", item.Quantity]</span>
                            </div>
                            <div class="col-md-2 text-end">
                                <span class="fw-bold">@item.TotalPrice.ToString("C", CultureInfo.CurrentCulture)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-calculator me-2"></i>@Localizer["OrderSummary"]
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>@Localizer["SubtotalLabel"]</span>
                        <span>@Model.OrderItems.Sum(i => i.TotalPrice).ToString("C", CultureInfo.CurrentCulture)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>@Localizer["ShippingLabel"]</span>
                        <span>@Localizer["ShippingValue"]</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between fw-bold">
                        <span>@Localizer["TotalLabel"]</span>
                        <span class="text-primary">@Model.TotalAmount.ToString("C", CultureInfo.CurrentCulture)</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-map-marker-alt me-2"></i>@Localizer["ShippingAddress"]
                    </h5>
                </div>
                <div class="card-body">
                    <address class="mb-0">
                        <strong>@Model.ShippingFirstName @Model.ShippingLastName</strong><br>
                        @Model.ShippingAddress<br>
                        @Model.ShippingCity, @Model.ShippingPostalCode<br>
                        @if (!string.IsNullOrEmpty(Model.ShippingPhone))
                        {
                            <abbr title="@Localizer["PhoneAbbreviation"]">@Localizer["PhoneLabel"]</abbr> @Model.ShippingPhone
                        }
                    </address>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function initRtlToggle(){
            const key = 'rtl_order_details';
            const resources = { rtlLabel: @Html.Raw(JsonSerializer.Serialize(Localizer["RtlToggleLabel"].Value)) };
            const $root = $('.container');
            const saved = sessionStorage.getItem(key) === '1';
            if (saved) $root.addClass('rtl');
            const id = 'rtl-toggle';
            if (!document.getElementById(id)) {
                $('body').append('<button id="' + id + '" class="btn btn-light border shadow-sm position-fixed" style="bottom:136px;right:16px;z-index:1030">' + resources.rtlLabel + '</button>');
                $('#' + id).on('click', function () {
                    $root.toggleClass("rtl");
                    sessionStorage.setItem(key, $root.hasClass('rtl') ? '1' : '0');
                });
            }
        })();
    </script>
}
