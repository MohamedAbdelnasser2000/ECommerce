    <div class="container">
        <main role="main" class="pb-3">
            @Html.AntiForgeryToken()
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer mt-5">
        <link href="~/css/footer-modern.css" rel="stylesheet" />
        <link href="~/css/footer-centering.css" rel="stylesheet" />
        <div class="container footer-wrap">
            <div class="footer-top">
                <!-- Brand & Social -->
                <div>
                    <div class="footer-brand"><i class="fas fa-shopping-bag"></i> @(ViewBag.SiteName ?? "E-Commerce Store")</div>
                    <p class="footer-desc">@(ViewBag.SiteDescription ?? "Your one-stop shop for all your needs. Quality products, great prices, and excellent service.")</p>
                    <div class="footer-social">
                        <a href="@((ViewBag.FacebookUrl as string) ?? "#")" aria-label="Facebook" rel="noopener" target="_blank"><i class="fab fa-facebook-f"></i></a>
                        <a href="@((ViewBag.TwitterUrl as string) ?? "#")" aria-label="Twitter" rel="noopener" target="_blank"><i class="fab fa-twitter"></i></a>
                        <a href="@((ViewBag.InstagramUrl as string) ?? "#")" aria-label="Instagram" rel="noopener" target="_blank"><i class="fab fa-instagram"></i></a>
                        <a href="@((ViewBag.LinkedInUrl as string) ?? "#")" aria-label="LinkedIn" rel="noopener" target="_blank"><i class="fab fa-linkedin"></i></a>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="footer-col">
                    <h6>@L["Quick Links"]</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">@L["Home"]</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">@L["Contact Us"]</a></li>
                        <li><a asp-controller="Home" asp-action="Blog">@L["Blog"]</a></li>
                        <li><a asp-controller="Product" asp-action="Index">@L["Products"]</a></li>
                    </ul>
                </div>

                <!-- Policies -->
                <div class="footer-col">
                    <h6>@L["Help & Policies"]</h6>
                    <ul class="footer-links">
                        <li><a href="#">@L["FAQ"]</a></li>
                        <li><a href="#">@L["Shipping & Returns"]</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">@L["Privacy Policy"]</a></li>
                        <li><a asp-controller="Home" asp-action="Terms">@L["Terms & Conditions"]</a></li>
                    </ul>
                </div>

                <!-- Newsletter -->
                <div class="footer-newsletter">
                    <h6>@L["Newsletter"]</h6>
                    <p>@L["Subscribe to receive the latest offers and products."]</p>
                    <form id="footerNewsletterForm">
                        <div class="input-group">
                            <input type="email" class="form-control" id="footerEmail" placeholder="@L["Your email"]" required>
                            <button type="submit">@L["Subscribe"]</button>
                        </div>
                    </form>
                    <div id="footerNewsletterResult" class="mt-2"></div>
                   
                </div>
            </div>

            <div class="footer-bottom">
                <div>&copy; 2025 Control A. @L["All rights reserved."]</div>
           @*      <div class="footer-legal">
                    <a asp-controller="Home" asp-action="Privacy">@L["Privacy Policy"]</a>
                    <a asp-controller="Home" asp-action="Terms">@L["Terms & Conditions"]</a>
                    <a asp-controller="Home" asp-action="Cookies">@L["Cookie Policy"]</a>
                </div> *@
            </div>
        </div>
    </footer>



