@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    var user = await UserManager.GetUserAsync(User);
    var firstName = user?.FirstName ?? string.Empty;
    var lastName = user?.LastName ?? string.Empty;
    var fullName = !string.IsNullOrEmpty(user?.FullName) ? user.FullName : User.Identity?.Name ?? string.Empty;
    var displayName = !string.IsNullOrEmpty(firstName) ? firstName : User.Identity?.Name ?? string.Empty;
    var cdn = (ViewBag.CdnBaseUrl as string) ?? string.Empty;
}
<!DOCTYPE html>
@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
<html lang="@lang" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <!-- cspell:ignore Topbar topbar wishlist Toastr preconnect linkedin instagram facebook -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrWhiteSpace(ViewBag.MetaTitle as string) ? (ViewBag.SiteName ?? "E-Commerce Store") : ViewBag.MetaTitle) - @ViewData["Title"]</title>
    <meta name="description" content="@((ViewBag.MetaDescription as string) ?? "")" />
    <meta name="keywords" content="@((ViewBag.MetaKeywords as string) ?? "")" />
    <link rel="canonical" href="@(($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}").ToString())" />
    <meta property="og:url" content="@(($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}").ToString())" />
    <meta property="og:type" content="website" />
    
    <!-- Resource Hints to speed up CDN font/css fetching -->
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>

    <!-- Favicon  -->
    <link rel="icon" href="~/img/core-img/favicon.ico">
    @* Open Graph basic tags *@
    <meta property="og:site_name" content="@(ViewBag.SiteName ?? "E-Commerce Store")" />
    <meta property="og:title" content="@((ViewBag.MetaTitle as string) ?? (ViewBag.SiteName ?? "E-Commerce Store"))" />
    <meta property="og:description" content="@((ViewBag.MetaDescription as string) ?? "")" />

    <!-- Core Style CSS -->
    <link href="@(string.IsNullOrWhiteSpace(cdn) ? Url.Content("~/css/core-style.css") : cdn + "/css/core-style.css")" rel="stylesheet" />
    <link href="@(string.IsNullOrWhiteSpace(cdn) ? Url.Content("~/css/style.css") : cdn + "/css/style.css")" rel="stylesheet" asp-append-version="true" />
    <link href="@(string.IsNullOrWhiteSpace(cdn) ? Url.Content("~/css/modern-homepage.css") : cdn + "/css/modern-homepage.css")" rel="stylesheet" />
    <link href="@(string.IsNullOrWhiteSpace(cdn) ? Url.Content("~/css/header-modern.css") : cdn + "/css/header-modern.css")" rel="stylesheet" />
    <link href="@(string.IsNullOrWhiteSpace(cdn) ? Url.Content("~/css/theme.pink-gold.css") : cdn + "/css/theme.pink-gold.css")" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    @RenderSection("Styles", required: false)
</head>
<body>

@*     <!-- Topbar Start -->
    <div class="topbar">
        <div class="container">
            <div>
                <span><i class="fas fa-truck me-1"></i>Free shipping on orders over $50</span>
                <span class="divider">|</span>
                <span><i class="fas fa-headset me-1"></i>Support: support@example.com</span>
            </div>
            <div>
                <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                <a href="#" class="ms-3" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                <a href="#" class="ms-3" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
            </div>
        </div>
    </div>
    <!-- Topbar End --> *@

    <!-- Modern Header Start -->
    <header class="modern-header">
        <div class="container">
            <div class="header-row">
                <!-- Left: Hamburger + Brand -->
                <button id="hamburger" class="hamburger" aria-label="Open menu"><span></span></button>
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-shopping-bag"></i>
                    <span>@(ViewBag.SiteName ?? "E-Commerce Store")</span>
                </a>

                <!-- Center: Nav + Search (search hidden on mobile) -->
                  <div class="center-area">
                    <ul class="main-links">
                        <li><a asp-controller="Home" asp-action="Index">@L["Home"]</a></li>
                        <li><a asp-controller="Product" asp-action="Index">@L["Products"]</a></li>
@*                         <li><a asp-controller="Search" asp-action="Index">@L["Search"]</a></li>
 *@                        @if (ViewBag.HeaderCategories != null)
                        {
                            foreach (var c in ViewBag.HeaderCategories)
                            {
                                <li><a asp-controller="Product" asp-action="Index" asp-route-categoryId="@c.Id">@c.DisplayName</a></li>
                            }
                        }
                        <li><a asp-controller="Home" asp-action="Contact">@L["Contact Us"]</a></li>
@*                         <li><a asp-controller="Home" asp-action="Blog">@L["Blog"]</a></li>
 *@                    </ul>
                 @*    <form class="search-inline" asp-controller="Search" asp-action="Index" method="get">
                        <input type="search" name="query" id="headerSearch" placeholder="البحث في المنتجات..." aria-label="Search" autocomplete="off">
                        <button type="submit" aria-label="Search"><i class="fa fa-search"></i></button>
                    </form> *@
                </div>

                <!-- Right: Actions -->
                <div class="actions">
                    <!-- Language Dropdown -->
                    <div class="dropdown d-none d-lg-block">
                        <a class="icon-btn dropdown-toggle" href="#" id="langDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-globe"></i>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="langDropdown">
                            <form method="post" asp-controller="Localization" asp-action="SetLanguage" class="px-3 py-1">
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button name="culture" value="en-US" type="submit" class="dropdown-item">English</button>
                                <button name="culture" value="ar-SA" type="submit" class="dropdown-item">العربية</button>
                            </form>
                        </div>
                    </div>

                    <!-- Wishlist -->
                    <a class="icon-btn" asp-controller="Wishlist" asp-action="Index" title="@L["Wishlist"]">
                        <i class="fas fa-heart"></i>
                        <span class="badge-dot" id="Wishlist-count" style="display:none;">0</span>
                    </a>
                    <!-- Cart -->
                    <a class="icon-btn" asp-controller="Cart" asp-action="Index" title="@L["Cart"]">
                        <i class="fas fa-shopping-bag"></i>
                        <span class="badge-dot" id="cart-count">0</span>
                    </a>


                    @if (User.Identity!.IsAuthenticated)
                    {
                        <!-- Notifications -->
                        <div class="dropdown">
                            <a class="icon-btn dropdown-toggle" href="#" id="notificationDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-bell"></i>
                                <span class="badge-dot" id="notification-count" style="display:none;">0</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right notification-dropdown" style="width: 350px; max-height: 400px; overflow-y: auto;">
                                <div class="dropdown-header d-flex justify-content-between align-items-center">
                                    <span><i class="fas fa-bell me-2"></i>@L["Notifications"]</span>
                                    <button type="button" class="btn btn-sm btn-link p-0 text-primary" onclick="markAllNotificationsAsRead()">@L["Mark all as read"]</button>
                                </div>
                                <div class="dropdown-divider"></div>
                                <div id="notification-list">
                                    <div class="dropdown-item-text text-center"><i class="fas fa-spinner fa-spin"></i> Loading...</div>
                                </div>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item text-center text-primary" asp-controller="Notification" asp-action="Index"><i class="fas fa-eye me-2"></i>@L["View All Notifications"]</a>
                            </div>
                        </div>

                        

                        <!-- User -->
                        <div class="dropdown">
                            <a class="icon-btn dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-user"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-right" aria-labelledby="userDropdown">
                                <li class="dropdown-item-text">
                                    <strong>@displayName</strong>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                @if (User.IsInRole("Customer"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="Dashboard"><i class="fas fa-user-circle me-2"></i>My Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="Profile"><i class="fas fa-user-edit me-2"></i>My Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="Orders"><i class="fas fa-box me-2"></i>My Orders</a></li>
                                    <li><a class="dropdown-item" asp-controller="Wishlist" asp-action="Index"><i class="fas fa-heart me-2"></i>My Wishlist</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item"><i class="fas fa-sign-out-alt me-2"></i>@L["Logout"]</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="icon-btn" asp-controller="Account" asp-action="Login" title="Login"><i class="fas fa-sign-in-alt"></i></a>
                        <a class="icon-btn" asp-controller="Account" asp-action="Register" title="Register"><i class="fas fa-user-plus"></i></a>
                    }
                </div>
            </div>
        </div>

    </header>
