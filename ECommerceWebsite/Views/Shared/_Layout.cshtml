    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-migrate/3.4.1/jquery-migrate.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <!-- Popper js -->
    <script src="@(string.IsNullOrWhiteSpace(cdn) ? Url.Content("~/js/popper.min.js") : cdn + "/js/popper.min.js")"></script>
    <!-- Bootstrap js -->
    <script src="@(string.IsNullOrWhiteSpace(cdn) ? Url.Content("~/js/bootstrap.min.js") : cdn + "/js/bootstrap.min.js")"></script>
    <!-- Plugins js -->
    <script src="@(string.IsNullOrWhiteSpace(cdn) ? Url.Content("~/js/plugins.js") : cdn + "/js/plugins.js")"></script>
    <!-- Active js -->
    <script src="@(string.IsNullOrWhiteSpace(cdn) ? Url.Content("~/js/active.js") : cdn + "/js/active.js")"></script>
    <!-- Toastr for notifications -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
        <!-- Notifications script -->
        <script src="@(string.IsNullOrWhiteSpace(cdn) ? Url.Content("~/js/notifications.js") : cdn + "/js/notifications.js")" asp-append-version="true"></script>
    }
    <!-- Site custom scripts -->
    <script src="@(string.IsNullOrWhiteSpace(cdn) ? Url.Content("~/js/site.js") : cdn + "/js/site.js")" asp-append-version="true"></script>
    
    <script>
        // Global notification settings
        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: 5000,
            extendedTimeOut: 2000,
            preventDuplicates: true
        };
        
        // Global function to show error messages
        window.showError = function(message, title = 'Error') {
            console.error(title + ': ' + message);
            if (window.toastr) {
                toastr.error(message, title);
            } else {
                alert(title + ': ' + message);
            }
        };
        
        // Global function to show success messages
        window.showSuccess = function(message, title = 'Success') {
            if (window.toastr) {
                toastr.success(message, title);
            } else {
                console.log(title + ': ' + message);
            }
        };
        
        // Initialize any page-specific functionality
        $(document).ready(function() {
            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();
            
            // Initialize popovers
            $('[data-bs-toggle="popover"]').popover();
            
            // Initialize cart and wishlist counts if functions exist
            if (typeof updateCartCount === 'function') {
                updateCartCount();
            }
            
            if (typeof updateWishlistCount === 'function') {
                updateWishlistCount();
            }
            
            // Handle mobile menu toggle
            $('#hamburger').on('click', function() {
                $(this).toggleClass('active');
                $('#mobileNav').toggleClass('open');
                $('#mobileOverlay').toggleClass('show');
                $('body').toggleClass('menu-open');
            });
            
            // Close mobile menu when clicking outside
            $('#mobileOverlay').on('click', function() {
                $(this).removeClass('show');
                $('#mobileNav').removeClass('open');
                $('#hamburger').removeClass('active');
                $('body').removeClass('menu-open');
            });
            
            // Close mobile menu when clicking a link
            $('#mobileNav a').on('click', function() {
                $('#mobileOverlay').removeClass('show');
                $('#mobileNav').removeClass('open');
                $('#hamburger').removeClass('active');
                $('body').removeClass('menu-open');
            });
            
            // Initialize any existing notification functionality
            if (typeof loadNotifications === 'function') {
                loadNotifications();
                // Refresh notifications every 30 seconds
                setInterval(loadNotifications, 30000);
            }
        });
    </script>

    @* Google Analytics *@
    @if (!string.IsNullOrWhiteSpace(ViewBag.GoogleAnalyticsId as string))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@ViewBag.GoogleAnalyticsId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);} 
            gtag('js', new Date());
            gtag('config', '@ViewBag.GoogleAnalyticsId');
        </script>
    }

    @* Facebook Pixel *@
    @if (!string.IsNullOrWhiteSpace(ViewBag.FacebookPixelId as string))
    {
        <script>
            !function(f,b,e,v,n,t,s)
            {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
            n.callMethod.apply(n,arguments):n.queue.push(arguments)};
            if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
            n.queue=[];t=b.createElement(e);t.async=!0;
            t.src=v;s=b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t,s)}(window, document,'script',
            'https://connect.facebook.net/en_US/fbevents.js');
            fbq('init', '@ViewBag.FacebookPixelId');
            fbq('track', 'PageView');
        </script>
        <noscript><img height="1" width="1" style="display:none"
            src="https://www.facebook.com/tr?id=@ViewBag.FacebookPixelId&ev=PageView&noscript=1"/></noscript>
    }

    @await RenderSectionAsync("Scripts", required: false)

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Organization",
      "name": "@(ViewBag.SiteName ?? "E-Commerce Store")",
      "url": "@((ViewBag.BaseUrl as string) ?? (Context?.Request?.Scheme + "://" + Context?.Request?.Host))",
      "logo": "@Url.Content("~/img/core-img/favicon.ico")",
      "sameAs": [
        "@((ViewBag.FacebookUrl as string) ?? "")",
        "@((ViewBag.TwitterUrl as string) ?? "")",
        "@((ViewBag.InstagramUrl as string) ?? "")",
        "@((ViewBag.LinkedInUrl as string) ?? "")"
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "name": "@(ViewBag.SiteName ?? "E-Commerce Store")",
      "url": "@((ViewBag.BaseUrl as string) ?? (Context?.Request?.Scheme + "://" + Context?.Request?.Host))",
      "potentialAction": {
        "@@type": "SearchAction",
        "target": "@Url.Action("Index","Search", null, Context.Request.Scheme)",
        "query-input": "required name=search"
      }
    }
    </script>

