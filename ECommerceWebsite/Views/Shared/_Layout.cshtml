                <li><a asp-controller="Home" asp-action="Contact"><i class="fas fa-envelope me-2"></i> @L["Contact Us"] </a></li>
@*                 <li><a asp-controller="Home" asp-action="Blog"><i class="fas fa-blog me-2"></i> @L["Blog"] </a></li>
 *@                @if (User.Identity!.IsAuthenticated)
                {
                    
                    <li><a asp-controller="Notification" asp-action="Index"><i class="fas fa-bell me-2"></i> @L["Notifications"] </a></li>
                    @if (User.IsInRole("Customer"))
                    {
                        <li><a asp-controller="Customer" asp-action="Dashboard"><i class="fas fa-user-circle me-2"></i> My Dashboard </a></li>
                        <li><a asp-controller="Customer" asp-action="Profile"><i class="fas fa-user-edit me-2"></i> My Profile </a></li>
                        <li><a asp-controller="Customer" asp-action="Orders"><i class="fas fa-box me-2"></i> My Orders </a></li>
                        
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="fas fa-tachometer-alt me-2"></i>Admin</a></li>
                    }
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item w-100 text-start"><i class="fas fa-sign-out-alt me-2"></i>Logout</button>
                        </form>
                    </li>
                }
                else
                {
                    <li><a asp-controller="Account" asp-action="Login"><i class="fas fa-sign-in-alt me-2"></i>Login</a></li>
                    <li><a asp-controller="Account" asp-action="Register"><i class="fas fa-user-plus me-2"></i>Register</a></li>
                }
                  <li class="d-lg-none">
                    <div class="dropdown">
                        <button class="nav-link dropdown-toggle" type="button" id="mobileLangDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-globe me-2"></i> @L["Language"]
                        </button>
                        <div class="dropdown-menu" aria-labelledby="mobileLangDropdown">
                            <form method="post" asp-controller="Localization" asp-action="SetLanguage" class="px-3 py-1">
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button name="culture" value="en-US" type="submit" class="dropdown-item">English</button>
                                <button name="culture" value="ar-SA" type="submit" class="dropdown-item">العربية</button>
                            </form>
                        </div>
                    </div>
                </li>

            </ul>
        </div>
    </nav>
