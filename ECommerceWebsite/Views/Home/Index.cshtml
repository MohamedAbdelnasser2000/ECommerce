@model IEnumerable<ECommerceWebsite.Models.Product>
@{
    ViewData["Title"] = @L["Home"];
    var categories = ViewBag.Categories as IEnumerable<ECommerceWebsite.Models.Category>;
    var siteName = ViewBag.SiteName as string ?? "E-Commerce Store";
    var siteDescription = ViewBag.SiteDescription as string ?? "Your online shopping destination";

    // Add custom CSS and JS for the modern design
    ViewBag.CustomCss = "/css/modern-homepage.css";
    ViewBag.CustomJs = "/js/modern-homepage.js";

    var fallbackImagePath = Url.Content("~/images/unnamed.jpg");
    var heroImageSrc = string.IsNullOrWhiteSpace(ViewBag.HeroImageUrl as string)
        ? fallbackImagePath
        : Url.Content(ViewBag.HeroImageUrl as string);
    var ctaBackgroundSrc = string.IsNullOrWhiteSpace(ViewBag.CtaBackgroundUrl as string)
        ? fallbackImagePath
        : Url.Content(ViewBag.CtaBackgroundUrl as string);
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    @if (ViewBag.CustomCss != null)
    {
        <link rel="stylesheet" href="@ViewBag.CustomCss" />
    }
}

@section Scripts {
    @if (ViewBag.CustomJs != null)
    {
        <script src="@ViewBag.CustomJs"></script>
    }
    <script>
        $(function(){
            if ($.fn.owlCarousel) {
                // Initialize Featured Products Carousel
                $('.featured-products-carousel').owlCarousel({
                    rtl: true,
                    loop: true,
                    margin: 20,
                    nav: true,
                    dots: false,
                    autoplay: true,
                    autoplayTimeout: 3500,
                    autoplayHoverPause: true,
                    smartSpeed: 600,
                    responsive: {
                        0:   { items: 2 },
                        576: { items: 2 },
                        768: { items: 3 },
                        992: { items: 4 }
                    },
                    navText: [
                        '<i class="fas fa-chevron-left"></i>',
                        '<i class="fas fa-chevron-right"></i>'
                    ]
                });

                // Initialize New Products Carousel
                $('.new-products-carousel').owlCarousel({
                    rtl: true,
                    loop: true,
                    margin: 20,
                    nav: true,
                    dots: false,
                    autoplay: true,
                    autoplayTimeout: 3500,
                    autoplayHoverPause: true,
                    smartSpeed: 600,
                    responsive: {
                        0:   { items: 2 },
                        576: { items: 2 },
                        768: { items: 3 },
                        992: { items: 4 }
                    },
                    navText: [
                        '<i class="fas fa-chevron-left"></i>',
                        '<i class="fas fa-chevron-right"></i>'
                    ]
                });
            } else {
                console.warn('Owl Carousel is not loaded');
            }
        });
    </script>
}



<!-- Hero Section (Modern Refresh) -->
<section class="hero-section hero-modern py-5 position-relative overflow-hidden">
    <!-- Decorative Background Elements -->
    <div class="hero-shape hero-shape-1"></div>
    <div class="hero-shape hero-shape-2"></div>
    <div class="hero-gradient-overlay"></div>

    <div class="container position-relative">
        <div class="row align-items-center g-5">
            <!-- Left: Content -->
            <div class="col-lg-6 order-1 order-lg-1">
                <div class="hero-content">
                    @if (!string.IsNullOrWhiteSpace(ViewBag.HeroBadge))
                    {
                        <span class="badge hero-badge mb-3"><i class="fas fa-bolt me-1"></i>@ViewBag.HeroBadge</span>
                    }
                    <h1 class="hero-title mb-3">@ViewBag.HeroTitle</h1>
                    <p class="hero-subtitle mb-4">@ViewBag.HeroSubtitle</p>
                    
                    <div class="d-flex flex-wrap gap-3">
                        <a href="@(ViewBag.HeroButtonLink ?? Url.Action("Index", "Product"))" class="btn btn-modern btn-lg">
                            <i class="fas fa-shopping-bag me-2"></i>@(ViewBag.HeroButtonText ?? "Shop Now")
                        </a>
                        
                    </div>

                    <!-- Trust Indicators -->
                   @* <div class="hero-trust chips mt-4">
                        <div class="chip">
                            <i class="fas fa-shipping-fast"></i><span>Fast delivery</span>
                        </div>
                        <div class="chip">
                            <i class="fas fa-undo"></i><span>Easy returns</span>
                        </div>
                        <div class="chip">
                            <i class="fas fa-lock"></i><span>Secure checkout</span>
                        </div>
                    </div>*@
                </div>
            </div>

            <!-- Right: Media -->
            <div class="col-lg-6 order-2 order-lg-2">
                <div class="hero-media position-relative text-center">
                    <img src="@heroImageSrc" alt="Hero" class="img-fluid hero-image" onerror="this.onerror=null;this.src='@fallbackImagePath';" />
                    <!-- Floating badges -->
                    <div class="floating-badge badge-1"><i class="fas fa-percentage"></i></div>
                    <div class="floating-badge badge-2"><i class="fas fa-gift"></i></div>
                    <div class="floating-badge badge-3"><i class="fas fa-heart"></i></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories Section - Modern -->
<section class="categories-modern py-5" id="categories">
    <div class="container">
        <div class="section-header text-center mb-4">
            <h2 class="section-title">@L["ShopByCategory"]</h2>
            <p class="section-subtitle text-muted">@L["CategoriesSubtitle"]</p>
        </div>

        <div class="categories-grid">
            @if (categories != null)
            {
                @foreach (var category in categories.Take(8))
                {
                    <a href="@Url.Action("Category", "Product", new { id = category.Id })" class="category-card-modern" aria-label="@category.GetLocalizedName()">
                        <div class="category-media" style="background-image:url('@(string.IsNullOrWhiteSpace(category.ImageUrl) ? fallbackImagePath : Url.Content(category.ImageUrl))')"></div>
                        <div class="category-overlay"></div>
                        <div class="category-content">
                            <h3 class="category-title">@category.GetLocalizedName()</h3>
                            <span class="category-link">@L["ShopNow"] <i class="fas fa-arrow-right ms-1"></i></span>
                        </div>
                    </a>
                }
            }
        </div>
    </div>
</section>
