<!-- ##### CTA Area Start ##### -->
<div class="cta-area">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="cta-content bg-img background-overlay" style="background-image: url('@ctaBackgroundSrc'); direction: ltr;">
                    <div class="h-100 d-flex align-items-center justify-content-end">
                        <div class="cta--text" style="text-align: right;">
                           <br />
                            <br />
                            <br />
                            <h6>@(ViewBag.CtaBadgeText ?? @L["CtaBadgeText"])</h6>
                            <h2>@(ViewBag.CtaTitle ?? @L["GlobalSale"])</h2>
                            @if (!string.IsNullOrWhiteSpace(ViewBag.CtaDescription))
                            {
                                <p class="text-light mb-3">@ViewBag.CtaDescription</p>
                            }
                            <a href="@(ViewBag.CtaButtonLink ?? Url.Action("Index", "Product"))" class="btn essence-btn">@(ViewBag.CtaButtonText ?? @L["BuyNow"])</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ##### CTA Area End ##### -->

<!-- Newsletter Modal -->
<div class="modal fade" id="newsletterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@L["SubscribeToNewsletter"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-4">@L["NewsletterUpdates"]</p>
                <form id="newsletter-form">
                    <div class="mb-3">
                        <input type="email" class="form-control" placeholder="@L["YourEmailAddress"]" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">@L["Subscribe"]</button>
                </form>
            </div>
        </div>
    </div>
</div>
