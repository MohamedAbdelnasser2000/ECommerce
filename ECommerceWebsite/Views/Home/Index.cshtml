<!-- Features Section -->
<section class="features-section bg-light py-5">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-3 mb-4">
                <div class="feature-item">
                    <i class="fas fa-shipping-fast fa-3x text-primary mb-3"></i>
                    <h5>@L["FastDeliveryTitle"]</h5>
                    <p class="text-muted">@L["FastDeliveryDesc"]</p>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="feature-item">
                    <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
                    <h5>@L["SecurePaymentTitle"]</h5>
                    <p class="text-muted">@L["SecurePaymentDesc"]</p>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="feature-item">
                    <i class="fas fa-undo fa-3x text-primary mb-3"></i>
                    <h5>@L["EasyReturnsTitle"]</h5>
                    <p class="text-muted">@L["EasyReturnsDesc"]</p>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="feature-item">
                    <i class="fas fa-headset fa-3x text-primary mb-3"></i>
                    <h5>@L["Support247Title"]</h5>
                    <p class="text-muted">@L["Support247Desc"]</p>
                </div>
            </div>
        </div>
    </div>
</section>