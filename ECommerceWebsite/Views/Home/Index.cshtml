<!-- ##### Featured Products Section ##### -->
<section class="featured-products-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">@L["FeaturedProducts"]</h2>
            <p class="section-subtitle">@L["FeaturedProductsSubtitle"]</p>
        </div>

        <div class="featured-products-carousel owl-carousel owl-theme" dir="rtl">
            @if (Model != null && Model.Any())
            {
                @foreach (var product in Model.Take(8))
                {
                    <div class="item"><div class="product-card">
                        <div class="product-image-container">
                            <img src="@Url.Content($"~/media/400x400/{(product.ImageUrl ?? "images/unnamed.jpg").TrimStart('/')}")" alt="@product.GetLocalizedName()" class="product-image" onerror="this.onerror=null; this.src='@Url.Content("~/media/400x400/images/unnamed.jpg")';">
                            @if (product.DiscountPrice.HasValue)
                            {
                                <span class="product-badge">Sale</span>
                            }
                        </div>
                        <div class="product-details">
                            <h3 class="product-title">@product.GetLocalizedName()</h3>
                           @* <p class="product-description">@product.Description.Substring(0, Math.Min(product.Description.Length, 80))...</p>*@
                            <div class="price-section">
                                @if (product.DiscountPrice.HasValue)
                                {
                                    <span class="current-price">$@product.DiscountPrice</span>
                                    <span class="original-price">$@product.Price</span>
                                }
                                else
                                {
                                    <span class="current-price">$@product.Price</span>
                                }
                            </div>
                            <div class="product-actions">
                                <a href="@Url.Action("Details", "Product", new { id = product.Id })" class="action-btn view-details-btn">
                                          <i class="fas fa-eye"></i>
                                </a>
                                <button class="action-btn Wishlist-btn" data-product-id="@product.Id">
                                    <i class="far fa-heart"></i>
                                </button>
                                    <button class="action-btn btn-add-to-cart " data-product-id="@product.Id">
                                        <i class="fas fa-shopping-cart"></i>
                                        @(product.StockQuantity > 0 ? "" : @L["OutOfStock"])
                                    </button>

                            </div>
                        </div>
                        </div></div>
                }
            }
            else
            {
                <div class="item">
                    <div class="col-12 text-center">
                        <div class="alert alert-info">@L["NoFeaturedProducts"]</div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

<!-- ##### New Products Carousel Section ##### -->
<section class="featured-products-section">
    <div class="container">


        <div class="new-products-carousel owl-carousel owl-theme" dir="rtl">
            @if (ViewBag.NewCarouselProducts != null && ((IEnumerable<ECommerceWebsite.Models.Product>)ViewBag.NewCarouselProducts).Any())
            {
                @foreach (var product in (IEnumerable<ECommerceWebsite.Models.Product>)ViewBag.NewCarouselProducts)
                {
                    <div class="item">
                        <div class="product-card">
                            <div class="product-image-container">
                                <img src="@Url.Content($"~/media/400x400/{(product.ImageUrl ?? "images/unnamed.jpg").TrimStart('/')}")" alt="@product.GetLocalizedName()" class="product-image" onerror="this.onerror=null; this.src='@Url.Content("~/media/400x400/images/unnamed.jpg")';">
                                @if (product.DiscountPrice.HasValue)
                                {
                                    <span class="product-badge">Sale</span>
                                }
                            </div>
                            <div class="product-details">
                                <h3 class="product-title">@product.GetLocalizedName()</h3>
                                <div class="price-section">
                                    @if (product.DiscountPrice.HasValue)
                                    {
                                        <span class="current-price">$@product.DiscountPrice</span>
                                        <span class="original-price">$@product.Price</span>
                                    }
                                    else
                                    {
                                        <span class="current-price">$@product.Price</span>
                                    }
                                </div>
                                <div class="product-actions">
                                    <a href="@Url.Action("Details", "Product", new { id = product.Id })" class="action-btn view-details-btn">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <button class="action-btn Wishlist-btn" data-product-id="@product.Id">
                                        <i class="far fa-heart"></i>
                                    </button>
                                    <button class="action-btn btn-add-to-cart " data-product-id="@product.Id">
                                        <i class="fas fa-shopping-cart"></i>
                                        @(product.StockQuantity > 0 ? "" : @L["OutOfStock"])
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="item">
                    <div class="col-12 text-center">
                        <div class="alert alert-info">No new products at the moment.</div>
                    </div>
                </div>
            }
        </div>

        <div class="view-all-container">
            <a href="@Url.Action("Index", "Product")" class="view-all-btn">
                <i class="fas fa-arrow-left"></i> @L["ViewAllProducts"]
            </a>
        </div>
    </div>
</section>


