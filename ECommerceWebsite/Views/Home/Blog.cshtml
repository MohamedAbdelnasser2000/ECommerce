@inject IViewLocalizer L
@{
    ViewData["Title"] = @L["Title"];
}

<section class="container py-5">
    <!-- Hero -->
    <div class="blog-hero p-4 p-md-5 rounded-4 mb-4">
        <div class="row align-items-center g-3">
            <div class="col-12 col-lg-8">
                <h1 class="fw-bold mb-2">@L["InsightsStories"]</h1>
                <p class="text-muted mb-0">@L["LatestTips"]</p>
            </div>
            <div class="col-12 col-lg-4">
                <div class="search-inline" style="max-width:100%">
                    <input type="search" id="blogSearch" placeholder="@L["SearchArticles"]" aria-label="@L["SearchArticles"]" />
                    <button type="button" aria-label="@L["Search"]"><i class="fa fa-search"></i></button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Articles -->
        <div class="col-12 col-lg-8">
            <div class="row g-4" id="blogGrid">
                <!-- Card 1 -->
                <div class="col-12 col-md-6 blog-card" data-title="Welcome to our store" data-tags="update news">
                    <article class="card h-100 shadow-soft">
                        <div class="ratio ratio-16x9 card-img-top cover" style="background-image:url('/img/bg-img/blog1.jpg')"></div>
                        <div class="card-body">
                            <a href="#" class="badge rounded-pill text-bg-light me-2">@L["Update"]</a>
                            <a href="#" class="badge rounded-pill text-bg-light">@L["News"]</a>
                            <h5 class="card-title mt-2">@L["WelcomeStore"]</h5>
                            <div class="card-meta small text-muted mb-2"><i class="far fa-calendar-alt me-1"></i> May 26, 2025 · <i class="far fa-clock mx-1"></i> 3 min</div>
                            <p class="card-text text-muted">@L["DiscoverNew"]</p>
                            <a href="#" class="stretched-link">@L["ReadMore"]</a>
                        </div>
                    </article>
                </div>
                <!-- Card 2 -->
                <div class="col-12 col-md-6 blog-card" data-title="How to choose the right product" data-tags="guide tips">
                    <article class="card h-100 shadow-soft">
                        <div class="ratio ratio-16x9 card-img-top cover" style="background-image:url('/img/bg-img/blog2.jpg')"></div>
                        <div class="card-body">
                            <a href="#" class="badge rounded-pill text-bg-light me-2">@L["Guide"]</a>
                            <a href="#" class="badge rounded-pill text-bg-light">@L["Tips"]</a>
                            <h5 class="card-title mt-2">@L["ChooseProduct"]</h5>
                            <div class="card-meta small text-muted mb-2"><i class="far fa-calendar-alt me-1"></i> May 20, 2025 · <i class="far fa-clock mx-1"></i> 5 min</div>
                            <p class="card-text text-muted">@L["Checklist"]</p>
                            <a href="#" class="stretched-link">@L["ReadMore"]</a>
                        </div>
                    </article>
                </div>
                <!-- Card 3 -->
                <div class="col-12 col-md-6 blog-card" data-title="Top 10 summer picks" data-tags="trends products">
                    <article class="card h-100 shadow-soft">
                        <div class="ratio ratio-16x9 card-img-top cover" style="background-image:url('/img/bg-img/blog3.jpg')"></div>
                        <div class="card-body">
                            <a href="#" class="badge rounded-pill text-bg-light me-2">@L["Trends"]</a>
                            <a href="#" class="badge rounded-pill text-bg-light">@L["Products"]</a>
                            <h5 class="card-title mt-2">@L["SummerPicks"]</h5>
                            <div class="card-meta small text-muted mb-2"><i class="far fa-calendar-alt me-1"></i> May 10, 2025 · <i class="far fa-clock mx-1"></i> 4 min</div>
                            <p class="card-text text-muted">@L["CuratedList"]</p>
                            <a href="#" class="stretched-link">@L["ReadMore"]</a>
                        </div>
                    </article>
                </div>
                <!-- Card 4 -->
                <div class="col-12 col-md-6 blog-card" data-title="Behind the scenes: packaging" data-tags="story sustainability">
                    <article class="card h-100 shadow-soft">
                        <div class="ratio ratio-16x9 card-img-top cover" style="background-image:url('/img/bg-img/blog4.jpg')"></div>
                        <div class="card-body">
                            <a href="#" class="badge rounded-pill text-bg-light me-2">@L["Story"]</a>
                            <a href="#" class="badge rounded-pill text-bg-light">@L["Sustainability"]</a>
                            <h5 class="card-title mt-2">@L["Packaging"]</h5>
                            <div class="card-meta small text-muted mb-2"><i class="far fa-calendar-alt me-1"></i> May 02, 2025 · <i class="far fa-clock mx-1"></i> 6 min</div>
                            <p class="card-text text-muted">@L["EcoPackaging"]</p>
                            <a href="#" class="stretched-link">@L["ReadMore"]</a>
                        </div>
                    </article>
                </div>
            </div>

            <!-- Pagination (placeholder) -->
            <nav class="mt-2" aria-label="Blog pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item disabled"><span class="page-link">@L["Prev"]</span></li>
                    <li class="page-item active"><span class="page-link">1</span></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item"><a class="page-link" href="#">@L["Next"]</a></li>
                </ul>
            </nav>
        </div>

        <!-- Sidebar -->
        <div class="col-12 col-lg-4">
            <aside class="p-3 p-md-4 rounded-4 sidebar-card mb-4">
                <h6 class="mb-3">@L["PopularTags"]</h6>
                <div class="d-flex flex-wrap gap-2">
                    <a href="#" class="badge rounded-pill text-bg-light tag-pill" data-filter="guide">@L["Guide"]</a>
                    <a href="#" class="badge rounded-pill text-bg-light tag-pill" data-filter="tips">@L["Tips"]</a>
                    <a href="#" class="badge rounded-pill text-bg-light tag-pill" data-filter="trends">@L["Trends"]</a>
                    <a href="#" class="badge rounded-pill text-bg-light tag-pill" data-filter="products">@L["Products"]</a>
                    <a href="#" class="badge rounded-pill text-bg-light tag-pill" data-filter="update">@L["Update"]</a>
                    <a href="#" class="badge rounded-pill text-bg-light tag-pill" data-filter="news">@L["News"]</a>
                </div>
            </aside>

            <aside class="p-3 p-md-4 rounded-4 sidebar-card">
                <h6 class="mb-3">@L["RecentPosts"]</h6>
                <div class="d-flex align-items-center mb-3">
                    <img src="/img/bg-img/rp1.jpg" class="rounded me-2" width="56" height="56" alt="recent" />
                    <div class="small">@L["WelcomeStore"]</div>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <img src="/img/bg-img/rp2.jpg" class="rounded me-2" width="56" height="56" alt="recent" />
                    <div class="small">@L["ChooseProduct"]</div>
                </div>
                <div class="d-flex align-items-center">
                    <img src="/img/bg-img/rp3.jpg" class="rounded me-2" width="56" height="56" alt="recent" />
                    <div class="small">@L["SummerPicks"]</div>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .blog-hero {
            background: rgba(255,255,255,.78);
            border: 1px solid rgba(0,0,0,.06);
            border-radius: 16px;
            -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
        }
        .shadow-soft { box-shadow: 0 10px 30px rgba(0,0,0,.04); border: 1px solid rgba(0,0,0,.06); }
        .cover { background-size: cover; background-position: center; border-top-left-radius: .5rem; border-top-right-radius: .5rem; }
        .sidebar-card { background:#fff; border: 1px solid rgba(0,0,0,.06); }
        .tag-pill { cursor: pointer; }
        /* match header-modern search */
        #blogSearch { height: 40px; border: 1px solid rgba(0,0,0,.06); border-radius: 10px; padding: 0 44px 0 14px; background:#fff; width:100%; }
        .search-inline button { right: 6px; }
        @@media (max-width: 992px) {
            .blog-hero { padding: 18px !important; }
        }
    </style>
}

@section Scripts {
    <script>
        // Simple client-side filter (title/tags)
        (function(){
            const search = document.getElementById('blogSearch');
            const cards = Array.from(document.querySelectorAll('#blogGrid .blog-card'));
            function applyFilter(q){
                const query = (q || '').toLowerCase().trim();
                cards.forEach(c => {
                    const text = (c.dataset.title + ' ' + c.dataset.tags).toLowerCase();
                    c.style.display = (!query || text.includes(query)) ? '' : 'none';
                });
            }
            search?.addEventListener('input', e => applyFilter(e.target.value));

            // Tag pills
            document.querySelectorAll('.tag-pill').forEach(el => {
                el.addEventListener('click', function(e){
                    e.preventDefault();
                    const f = this.getAttribute('data-filter');
                    if (f) { applyFilter(f); search.value = f; }
                });
            });
        })();
    </script>
}