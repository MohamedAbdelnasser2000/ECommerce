@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    ViewData["Title"] = L["Terms & Conditions"]; 
}

<section class="container my-4">
    <h1>@L["Terms & Conditions"]</h1>
    <p>@L["These Terms govern your use of our website and services. By accessing or using the site, you agree to be bound by these Terms. If you do not agree, do not use the site."]</p>

    <h3>@L["Use of the Website"]</h3>
    <p>@L["You agree not to misuse the website or assist anyone else in doing so. You must comply with all applicable laws."]</p>

    <h3>@L["Accounts"]</h3>
    <p>@L["You are responsible for maintaining the confidentiality of your account and password and for restricting access to your device."]</p>

    <h3>@L["Orders and Payments"]</h3>
    <p>@L["All orders are subject to acceptance and availability. Prices, promotions, and availability may change without notice."]</p>

    <h3>@L["Liability"]</h3>
    <p>@L["To the maximum extent permitted by law, we are not liable for indirect, incidental, or consequential damages."]</p>

    <h3>@L["Changes to Terms"]</h3>
    <p>@L["We may update these Terms from time to time. Continued use of the site constitutes acceptance of the updated Terms."]</p>
</section>


