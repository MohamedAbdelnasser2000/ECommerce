            <!-- Benefits Section -->
            <div class="benefits-section">
                <div class="benefits-grid">
                    @*<div class="benefit-item">
                        <i class="fas fa-shipping-fast"></i>
                        <span>@L["FreeShipping"]</span>
                    </div>*@
                    <div class="benefit-item">
                        <i class="fas fa-undo"></i>
                        <span>@L["Returns"]</span>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-shield-alt"></i>
                        <span>@L["Warranty"]</span>
                    </div>
                   @* <div class="benefit-item">
                        <i class="fas fa-headset"></i>
                        <span>@L["Support"]</span>
                    </div>*@
                </div>
            </div>

            <!-- Share Section -->
            <div class="share-section">
                <h6>@L["ShareProduct"]</h6>
                <div class="share-buttons">
                    <button class="share-btn" id="copyLinkBtn" title="@L["CopyLink"]" style="background: var(--gold-primary);">
                        <i class="fas fa-link"></i>
                    </button>
                    <a class="share-btn facebook" href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl" target="_blank" rel="noopener" title="@L["ShareFacebook"]">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a class="share-btn twitter" href="https://twitter.com/intent/tweet?url=@encodedUrl&text=@encodedName" target="_blank" rel="noopener" title="@L["ShareTwitter"]">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a class="share-btn whatsapp" href="https://wa.me/?text=@encodedWhats" target="_blank" rel="noopener" title="@L["ShareWhatsApp"]">
                        <i class="fab fa-whatsapp"></i>
                    </a>
                    <a class="share-btn pinterest" href="https://pinterest.com/pin/create/button/?url=@encodedUrl&media=@mainImage&description=@encodedName" target="_blank" rel="noopener" title="@L["SharePinterest"]">
                        <i class="fab fa-pinterest-p"></i>
                    </a>
                    <a class="share-btn linkedin" href="https://www.linkedin.com/sharing/share-offsite/?url=@encodedUrl" target="_blank" rel="noopener" title="@L["ShareLinkedIn"]">
                        <i class="fab fa-linkedin-in"></i>
                    </a>
                </div>
            </div>
