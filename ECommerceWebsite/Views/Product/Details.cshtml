    <!-- Product Tabs Section -->
    <div class="product-tabs">
        <div class="tabs-header">
            <ul class="nav nav-tabs-modern" id="detailsTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab">
                        <i class="fas fa-info-circle me-2"></i>@L["Description"]
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab">
                        <i class="fas fa-star me-2"></i>@L["Reviews"] (@Model.ReviewCount)
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content">
            <!-- Description Tab -->
            <div class="tab-pane fade show active" id="desc" role="tabpanel">
                <div class="description-content">
                    @{
                        var localizedDesc = Model.GetLocalizedDescription();
                    }
                    @if (!string.IsNullOrWhiteSpace(localizedDesc))
                    {
                        <p>@localizedDesc</p>
                    }
                    else
                    {
                        <p class="text-muted">@L["NoDescription"]</p>
                    }
                </div>
            </div>

            <!-- Reviews Tab -->
            <div class="tab-pane fade" id="reviews" role="tabpanel">
                <div class="reviews-section">
                    @if (Model.Reviews != null && Model.Reviews.Any(r => r.IsApproved))
                    {
                        foreach (var review in Model.Reviews.Where(r => r.IsApproved).OrderByDescending(r => r.CreatedAt))
                        {
                            <div class="review-item">
                                <div class="review-header">
                                    <div class="reviewer-info">
                                        <div class="reviewer-name">@review.User?.FirstName @review.User?.LastName</div>
                                        <div class="review-stars">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <div class="review-date">@review.CreatedAt.ToString("MMM dd, yyyy")</div>
                                </div>
                                <div class="review-text">@review.Comment</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-comments fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">@L["NoReviews"]</h5>
                            <p class="text-muted">@L["FirstReview"]</p>
                        </div>
                    }

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <div class="write-review-section">
                            <h5 class="mb-4">
                                <i class="fas fa-edit me-2" style="color: var(--gold-primary);"></i>
                                @L["WriteReview"]
                            </h5>
                            <form id="review-form">
                                <div class="mb-4">
                                    <label class="form-label fw-bold mb-3">@L["YourRating"]</label>
                                    <div class="rating-input-group">
                                        @for (int i = 5; i >= 1; i--)
                                        {
                                            <input type="radio" name="rating" value="@i" id="star@i" class="rating-radio">
                                            <label for="star@i" class="rating-star">
                                                <i class="fas fa-star"></i>
                                            </label>
                                        }
                                    </div>
                                    <div class="rating-labels mt-2">
                                        <small class="text-muted">@L["Poor"]</small>
                                        <small class="text-muted ms-auto">@L["Excellent"]</small>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold">@L["YourReview"]</label>
                                    <textarea class="review-form-control" name="comment" rows="4" placeholder="@L["ReviewPlaceholder"]"></textarea>
                                </div>

                                <button type="submit" class="btn-submit-review">
                                    <i class="fas fa-paper-plane me-2"></i>@L["SubmitReview"]
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <p class="text-muted mb-3">@L["LoginToReviewText"]</p>
                            <a href="@Url.Action("Login", "Account")" class="btn-submit-review" style="padding: 0.8rem 2rem;">
                                <i class="fas fa-sign-in-alt me-2"></i>@L["LoginToReview"]
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.RelatedProducts != null && ((IEnumerable<ECommerceWebsite.Models.Product>)ViewBag.RelatedProducts).Any())
{
    <div class="container-fluid px-3 px-md-4 related-products">
        <h3 class="mb-4">
            <i class="fas fa-th-large me-2" style="color: var(--gold-primary);"></i>@L["YouMayAlsoLike"]
        </h3>
        <div class="row g-3">
            @foreach (var p in (IEnumerable<ECommerceWebsite.Models.Product>)ViewBag.RelatedProducts)
            {
                var img = string.IsNullOrWhiteSpace(p.ImageUrl) ? null : p.ImageUrl;
                var relatedImagePath = string.IsNullOrWhiteSpace(img)
                    ? relatedFallbackImagePath
                    : Url.Content($"/media/400x400/{img.TrimStart('/')}");

                <div class="col-6 col-md-3">
                    <a href="@Url.Action("Details", "Product", new { id = p.Id })" class="card h-100 text-decoration-none">
                        <img class="card-img-top" src="@relatedImagePath" alt="@p.GetLocalizedName()" onerror="this.onerror=null; this.src='@relatedFallbackImagePath';" />
                        <div class="card-body p-2">
                            <div class="text-truncate small fw-semibold" title="@p.GetLocalizedName()">@p.GetLocalizedName()</div>
                            <div class="mt-1">
                                @if (p.DiscountPrice.HasValue)
                                {
                                    <span class="text-danger fw-bold">$@p.DiscountPrice</span>
                                    <span class="text-muted text-decoration-line-through ms-1 small">$@p.Price</span>
                                }
                                else
                                {
                                    <span class="fw-bold">$@p.Price</span>
                                }
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
}

<!-- Lightbox Modal -->
<div class="modal fade lightbox-modal" id="lightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-body p-0">
                <div id="lightboxCarousel" class="carousel slide" data-ride="carousel" data-interval="4000" data-pause="hover">
                    <div class="carousel-inner">
                        @for (int i = 0; i < galleryImages.Count; i++)
                        {
                            var img = galleryImages[i];
                            var lightboxImagePath = string.IsNullOrWhiteSpace(img)
                                ? fallbackImagePath
                                : Url.Content($"~/images/{img.TrimStart('/')}");

                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@lightboxImagePath" class="d-block w-100" alt="@Model.GetLocalizedName() image @(i+1)" onerror="this.onerror=null; this.src='@fallbackImagePath';" />
                            </div>
                        }
                    </div>
                    <a class="carousel-control-prev" href="#lightboxCarousel" role="button" data-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="sr-only">@L["Previous"]</span>
                    </a>
                    <a class="carousel-control-next" href="#lightboxCarousel" role="button" data-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="sr-only">@L["Next"]</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Thumbnails -> Carousel navigation
            $('.thumb-item').on('click', function () {
                $('.thumb-item').removeClass('active');
                $(this).addClass('active');
            });

            // Open lightbox with current slide synced
            $('#openLightbox').on('click', function () {
                const mainIdx = $('#productCarousel .carousel-item.active').index();
                const lb = new bootstrap.Modal(document.getElementById('lightboxModal'));
                lb.show();
                const lightboxCar = document.getElementById('lightboxCarousel');
                const car = bootstrap.Carousel.getOrCreateInstance(lightboxCar);
                car.to(mainIdx);
            });

            // Sync lightbox carousel with main carousel when slide changes
            const mainCarouselEl = document.getElementById('productCarousel');
            const lightboxCarouselEl = document.getElementById('lightboxCarousel');
            const counterEl = document.getElementById('slideCounter');
            function updateCounter(idx) {
                if (!counterEl) return;
                const total = parseInt(counterEl.getAttribute('data-total')) || 0;
                counterEl.textContent = (idx + 1) + '/' + total;
            }
            if (mainCarouselEl && lightboxCarouselEl) {
                $(mainCarouselEl).on('slid.bs.carousel', function () {
                    const idx = $(mainCarouselEl).find('.carousel-item.active').index();
                    updateCounter(idx);
                    $(lightboxCarouselEl).carousel(idx);
                    $('.thumb').removeClass('active');
                    $('.thumb').eq(idx).addClass('active');
                });
                $(lightboxCarouselEl).on('slid.bs.carousel', function () {
                    const idx = $(lightboxCarouselEl).find('.carousel-item.active').index();
                    $(mainCarouselEl).carousel(idx);
                    updateCounter(idx);
                    $('.thumb').removeClass('active');
                    $('.thumb').eq(idx).addClass('active');
                });
                // Initialize counter to current index on load
                const startIdx = $(mainCarouselEl).find('.carousel-item.active').index() || 0;
                updateCounter(startIdx);
            }

            // Quantity controls
            $('#increase-qty').click(function () {
                var qty = parseInt($('#quantity').val());
                var max = parseInt($('#quantity').attr('max'));
                if (qty < max) $('#quantity').val(qty + 1);
            });
            $('#decrease-qty').click(function () {
                var qty = parseInt($('#quantity').val());
                if (qty > 1) $('#quantity').val(qty - 1);
            });

            // Copy link button
            const copyBtn = document.getElementById('copyLinkBtn');
            if (copyBtn) {
                try { $(copyBtn).tooltip(); } catch(e) {}
                copyBtn.addEventListener('click', async function () {
                    const text = '@currentUrl';
                    async function clipboardWrite(txt) {
                        try {
                            if (navigator.clipboard && window.isSecureContext) {
                                await navigator.clipboard.writeText(txt);
                                return true;
                            }
                        } catch (e) { /* fall back */ }
                        try {
                            const ta = document.createElement('textarea');
                            ta.value = txt;
                            ta.style.position = 'fixed';
                            ta.style.left = '-9999px';
                            document.body.appendChild(ta);
                            ta.focus();
                            ta.select();
                            const ok = document.execCommand('copy');
                            document.body.removeChild(ta);
                            return ok;
                        } catch (e) {
                            return false;
                        }
                    }
                    const ok = await clipboardWrite(text);
                    if (ok) {
                        copyBtn.classList.remove('btn-outline-secondary');
                        copyBtn.classList.add('btn-success');
                        copyBtn.innerHTML = '<i class="fas fa-check me-1"></i> Copied';
                        setTimeout(() => {
                            copyBtn.classList.remove('btn-success');
                            copyBtn.classList.add('btn-outline-secondary');
                            copyBtn.innerHTML = '<i class="fas fa-link me-1"></i> Copy Link';
                        }, 1500);
                    } else {
                        alert('Failed to copy link');
                    }
                });
            }

            // Add to cart
            $('#add-to-cart-btn').click(function () {
                var productId = $(this).data('product-id');
                var quantity = parseInt($('#quantity').val());
                var button = $(this);

                button.prop('disabled', true);
                button.html('<i class="fas fa-spinner fa-spin me-2"></i>Adding...');

                $.post('@Url.Action("AddToCart", "Cart")', { productId: productId, quantity: quantity })
                    .done(function (response) {
                        if (response.success) {
                            button.html('<i class="fas fa-check me-2"></i>Added to Cart!');
                            button.removeClass('btn-primary').addClass('btn-success');

                            if (typeof updateCartCount === 'function') {
                                try { updateCartCount(); } catch (_) { $('#cart-count').text(response.cartCount); }
                            } else {
                                $('#cart-count').text(response.cartCount);
                            }

                            setTimeout(function () {
                                button.html('<i class="fas fa-shopping-cart me-2"></i>Add to Cart');
                                button.removeClass('btn-success').addClass('btn-primary');
                                button.prop('disabled', false);
                            }, 2000);
                        } else {
                            alert(response.message);
                            button.prop('disabled', false).html('<i class="fas fa-shopping-cart me-2"></i>Add to Cart');
                        }
                    })
                    .fail(function () {
                        alert('Error adding product to cart');
                        button.prop('disabled', false).html('<i class="fas fa-shopping-cart me-2"></i>Add to Cart');
                    });
            });

            // Wishlist
            $('#add-to-wishlist-btn').click(function () {
                var productId = $(this).data('product-id');
                var button = $(this);
                button.prop('disabled', true);
                $.ajax({
                    url: '@Url.Action("AddToWishlist", "Wishlist")',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ ProductId: productId }),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    }
                })
                .done(function (response) {
                    if (response.success) {
                        button.html('<i class="fas fa-check me-2"></i>Added to Wishlist');
                        setTimeout(function() {
                            button.html('<i class="fas fa-heart me-2"></i>Add to Wishlist');
                        }, 2000);
                    } else {
                        alert(response.message || 'Could not add to wishlist');
                        button.prop('disabled', false);
                    }
                })
                .fail(function () {
                    alert('Error adding to wishlist');
                    button.prop('disabled', false);
                });
            });
        });
    </script>
}
