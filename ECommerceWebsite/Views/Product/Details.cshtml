                                <i class="fas fa-minus"></i>
                            </button>
                            <input type="number" class="quantity-input" id="quantity" value="1" min="1" max="@Model.StockQuantity">
                            <button class="quantity-btn" type="button" id="increase-qty">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
