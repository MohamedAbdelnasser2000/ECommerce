                        <i class="fas fa-heart me-2"></i>@L["AddToWishlist"]
                    </button>

                  @*  @if (User.Identity!.IsAuthenticated)
                    {
                        <button class="btn-add-cart" id="add-to-cart-btn" data-product-id="@Model.Id">
                            <i class="fas fa-cart-plus me-2"></i>Add to Cart
                        </button>
                        <button class="btn-wishlist" id="add-to-wishlist-btn" data-product-id="@Model.Id">
                            <i class="fas fa-heart me-2"></i>Add to Wishlist
                        </button>
