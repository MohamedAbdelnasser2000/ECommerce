@model ECommerceWebsite.ViewModels.TaxSettingViewModel

@{
    ViewData["Title"] = "تعديل إعدادات الضريبة";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">تعديل إعدادات الضريبة: @Model.Country</h4>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="Edit">
                        <div asp-validation-summary="All" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Country" class="form-label">الدولة *</label>
                                    <input asp-for="Country" class="form-control" placeholder="مثال: السعودية، مصر، الإمارات" />
                                    <span asp-validation-for="Country" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Region" class="form-label">المنطقة/المحافظة</label>
                                    <input asp-for="Region" class="form-control" placeholder="مثال: الرياض، القاهرة، دبي (اختياري)" />
                                    <span asp-validation-for="Region" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="City" class="form-label">المدينة</label>
                                    <input asp-for="City" class="form-control" placeholder="مثال: جدة، الإسكندرية، أبوظبي (اختياري)" />
                                    <span asp-validation-for="City" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TaxRate" class="form-label">معدل الضريبة (%) *</label>
                                    <input asp-for="TaxRate" class="form-control" type="number" step="0.01" min="0" max="100" placeholder="مثال: 15.5" />
                                    <span asp-validation-for="TaxRate" class="text-danger"></span>
                                    <div class="form-text">أدخل معدل الضريبة بالنسبة المئوية (مثال: 15 لـ 15%، 5.5 لـ 5.5%)</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActive">
                                <label class="form-check-label" for="IsActive">
                                    نشط
                                </label>
                            </div>
                            <span asp-validation-for="IsActive" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">ملاحظات</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="ملاحظات إضافية حول الضريبة (اختياري)"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> العودة للقائمة
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> حفظ التغييرات
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
