@model IEnumerable<ECommerceWebsite.Models.EmailTemplate>
@{
    ViewData["Title"] = "Email Templates";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">Email Templates</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Email")">Email</a></li>
                        <li class="breadcrumb-item active">Templates</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-file-alt mr-2"></i>
                        Email Templates Management
                    </h3>
                    <div class="card-tools">
                        <a href="@Url.Action("CreateTemplate")" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> Create New Template
                        </a>
                        <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Back to Email Logs
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped" id="templatesTable">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Type</th>
                                        <th>Subject</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var template in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@template.Name</strong>
                                            </td>
                                            <td>
                                                <span class="badge badge-info">@template.Type</span>
                                            </td>
                                            <td>@template.Subject</td>
                                            <td>
                                                @if (template.IsActive)
                                                {
                                                    <span class="badge badge-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">Inactive</span>
                                                }
                                            </td>
                                            <td>@template.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-info"
                                                            onclick="previewTemplate(@template.Id)" title="Preview">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <a href="@Url.Action("EditTemplate", new { id = template.Id })"
                                                       class="btn btn-warning" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-danger"
                                                            onclick="deleteTemplate(@template.Id)" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No email templates found</h5>
                            <p class="text-muted">Create your first email template to get started.</p>
                            <a href="@Url.Action("CreateTemplate")" class="btn btn-primary">
                                <i class="fas fa-plus mr-2"></i>Create Template
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Template Preview</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" id="previewContent">
                <!-- Preview content will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($.fn.DataTable) {
                $('#templatesTable').DataTable({
                    "responsive": true,
                    "lengthChange": false,
                    "autoWidth": false,
                    "order": [[4, "desc"]],
                    "pageLength": 25
                });
            }
        });

        function previewTemplate(templateId) {
            // Show loading
            $('#previewContent').html(`
                <div class="text-center py-4">
                    <i class="fas fa-spinner fa-spin fa-2x mb-3"></i>
                    <p>Loading template preview...</p>
                </div>
            `);
            $('#previewModal').modal('show');

            // Fetch template content
            $.get('/Admin/Email/PreviewTemplate/' + templateId)
                .done(function(response) {
                    if (response.success) {
                        const template = response.template;
                        $('#previewContent').html(`
                            <div class="mb-3">
                                <h5><i class="fas fa-envelope me-2"></i>Subject: ${template.subject}</h5>
                                <hr>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <ul class="nav nav-tabs" id="previewTabs" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link active" id="html-preview-tab" data-bs-toggle="tab" data-bs-target="#html-preview" type="button" role="tab">
                                                <i class="fas fa-code me-1"></i>HTML Preview
                                            </button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link" id="text-preview-tab" data-bs-toggle="tab" data-bs-target="#text-preview" type="button" role="tab">
                                                <i class="fas fa-file-alt me-1"></i>Text Content
                                            </button>
                                        </li>
                                    </ul>
                                    <div class="tab-content mt-3" id="previewTabsContent">
                                        <div class="tab-pane fade show active" id="html-preview" role="tabpanel">
                                            <div class="border p-3" style="max-height: 400px; overflow-y: auto; background: white;">
                                                ${template.htmlContent || '<p class="text-muted">No HTML content</p>'}
                                            </div>
                                        </div>
                                        <div class="tab-pane fade" id="text-preview" role="tabpanel">
                                            <div class="border p-3" style="max-height: 400px; overflow-y: auto; background: #f8f9fa;">
                                                <pre style="white-space: pre-wrap; font-family: inherit;">${template.textContent || 'No text content'}</pre>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `);
                    } else {
                        $('#previewContent').html(`
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                ${response.message || 'Failed to load template'}
                            </div>
                        `);
                    }
                })
                .fail(function() {
                    $('#previewContent').html(`
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Failed to load template preview
                        </div>
                    `);
                });
        }

        function deleteTemplate(templateId) {
            if (confirm('Are you sure you want to delete this template? This action cannot be undone.')) {
                // Show loading state
                const deleteBtn = $(`button[onclick="deleteTemplate(${templateId})"]`);
                const originalHtml = deleteBtn.html();
                deleteBtn.html('<i class="fas fa-spinner fa-spin"></i>').prop('disabled', true);

                $.post('/Admin/Email/DeleteTemplate/' + templateId)
                    .done(function(response) {
                        if (response.success) {
                            toastr.success(response.message || 'Template deleted successfully');
                            // Remove the row from table
                            deleteBtn.closest('tr').fadeOut(500, function() {
                                $(this).remove();
                                // Check if table is empty
                                if ($('#templatesTable tbody tr:visible').length === 0) {
                                    location.reload();
                                }
                            });
                        } else {
                            toastr.error(response.message || 'Failed to delete template');
                            deleteBtn.html(originalHtml).prop('disabled', false);
                        }
                    })
                    .fail(function() {
                        toastr.error('Failed to delete template');
                        deleteBtn.html(originalHtml).prop('disabled', false);
                    });
            }
        }
    </script>
}

<style>
    .table th {
        border-top: none;
        font-weight: 600;
    }

    .badge {
        font-size: 0.75em;
    }

    .btn-group-sm .btn {
        padding: 0.25rem 0.5rem;
    }
</style>
