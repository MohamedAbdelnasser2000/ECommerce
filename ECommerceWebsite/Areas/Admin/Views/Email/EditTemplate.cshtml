@model ECommerceWebsite.Models.EmailTemplate

@{
    ViewData["Title"] = "Edit Email Template";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-edit me-2"></i>Edit Email Template: @Model.Name
                </h3>
                <div class="card-tools">
                    <a asp-action="Templates" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to Templates
                    </a>
                </div>
            </div>
            <form asp-action="EditTemplate" method="post">
                <input asp-for="Id" type="hidden" />
                <input asp-for="CreatedAt" type="hidden" />
                <input asp-for="IsActive" type="hidden" />
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Name" class="form-label">Template Name</label>
                                <input asp-for="Name" class="form-control" placeholder="Enter template name" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Subject" class="form-label">Email Subject</label>
                                <input asp-for="Subject" class="form-control" placeholder="Enter email subject" required />
                                <span asp-validation-for="Subject" class="text-danger"></span>
                            </div>
                        </div>
                    </div>



                    <div class="row">
                        <div class="col-12">
                            <ul class="nav nav-tabs" id="templateTabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="html-tab" data-bs-toggle="tab" data-bs-target="#html" type="button" role="tab">
                                        <i class="fas fa-code me-1"></i>HTML Content
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="text-tab" data-bs-toggle="tab" data-bs-target="#text" type="button" role="tab">
                                        <i class="fas fa-file-alt me-1"></i>Text Content
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="preview-tab" data-bs-toggle="tab" data-bs-target="#preview" type="button" role="tab">
                                        <i class="fas fa-eye me-1"></i>Preview
                                    </button>
                                </li>
                            </ul>
                            <div class="tab-content" id="templateTabsContent">
                                <div class="tab-pane fade show active" id="html" role="tabpanel">
                                    <div class="form-group mt-3">
                                        <label asp-for="HtmlContent" class="form-label">HTML Content</label>
                                        <textarea asp-for="HtmlContent" class="form-control" rows="15" id="htmlEditor" placeholder="Enter HTML content for the email template"></textarea>
                                        <span asp-validation-for="HtmlContent" class="text-danger"></span>
                                        <small class="form-text text-muted">
                                            You can use placeholders like {{CustomerName}}, {{OrderNumber}}, {{ProductName}}, etc.
                                        </small>
                                    </div>
                                </div>
                                <div class="tab-pane fade" id="text" role="tabpanel">
                                    <div class="form-group mt-3">
                                        <label asp-for="TextContent" class="form-label">Text Content</label>
                                        <textarea asp-for="TextContent" class="form-control" rows="15" placeholder="Enter plain text content for the email template"></textarea>
                                        <span asp-validation-for="TextContent" class="text-danger"></span>
                                        <small class="form-text text-muted">
                                            Plain text version for email clients that don't support HTML.
                                        </small>
                                    </div>
                                </div>
                                <div class="tab-pane fade" id="preview" role="tabpanel">
                                    <div class="mt-3">
                                        <div class="card">
                                            <div class="card-header">
                                                <h5 class="card-title mb-0">Email Preview</h5>
                                            </div>
                                            <div class="card-body">
                                                <div id="emailPreview" class="border p-3" style="min-height: 300px; background: #f8f9fa;">
                                                    <p class="text-muted text-center">
                                                        <i class="fas fa-eye fa-2x mb-2"></i><br>
                                                        Click "Update Preview" to see the email content
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Templates" class="btn btn-secondary">
                            <i class="fas fa-times me-1"></i>Cancel
                        </a>
                        <div>
                            <button type="button" class="btn btn-info me-2" onclick="updatePreview()">
                                <i class="fas fa-eye me-1"></i>Update Preview
                            </button>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i>Update Template
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Template Info Card -->
<div class="row mt-3">
    <div class="col-12">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-info-circle me-2"></i>Template Information
                </h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Created:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                        <p><strong>Status:</strong>
                            <span class="badge bg-@(Model.IsActive ? "success" : "danger")">
                                @(Model.IsActive ? "Active" : "Inactive")
                            </span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Last Updated:</strong> @(Model.UpdatedAt?.ToString("MMM dd, yyyy HH:mm") ?? "Never")</p>
                        <p><strong>Template ID:</strong> #@Model.Id</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updatePreview() {
            const htmlContent = document.getElementById('htmlEditor').value;
            const previewDiv = document.getElementById('emailPreview');

            if (htmlContent.trim()) {
                previewDiv.innerHTML = htmlContent;
            } else {
                previewDiv.innerHTML = `
                    <p class="text-muted text-center">
                        <i class="fas fa-eye fa-2x mb-2"></i><br>
                        Preview will appear here when you add HTML content
                    </p>
                `;
            }
        }

        // Auto-update preview when switching to preview tab
        document.getElementById('preview-tab').addEventListener('click', function() {
            setTimeout(updatePreview, 100);
        });

        // Load preview on page load if content exists
        document.addEventListener('DOMContentLoaded', function() {
            const htmlContent = document.getElementById('htmlEditor').value;
            if (htmlContent.trim()) {
                updatePreview();
            }
        });
    </script>
}

<style>
    .nav-tabs .nav-link {
        border: 1px solid transparent;
        border-top-left-radius: 0.25rem;
        border-top-right-radius: 0.25rem;
    }

    .nav-tabs .nav-link.active {
        background-color: #fff;
        border-color: #dee2e6 #dee2e6 #fff;
    }

    #emailPreview {
        max-height: 400px;
        overflow-y: auto;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
    }

    .card-info .card-header {
        background-color: #17a2b8;
        color: white;
    }
</style>
