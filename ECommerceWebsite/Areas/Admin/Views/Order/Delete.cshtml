@model ECommerceWebsite.Models.Order

@{
    ViewData["Title"] = "Delete Order";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>Delete Order
                </h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Warning!</strong> Are you sure you want to delete this order? This action cannot be undone.
                </div>

                <!-- Order Information -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="card card-outline card-info">
                            <div class="card-header">
                                <h6 class="mb-0">Order Information</h6>
                            </div>
                            <div class="card-body">
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <th width="40%">Order Number:</th>
                                        <td><strong>#@Model.OrderNumber</strong></td>
                                    </tr>
                                    <tr>
                                        <th>Order Date:</th>
                                        <td>@Model.OrderDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")</td>
                                    </tr>
                                    <tr>
                                        <th>Status:</th>
                                        <td>
                                            <span class="badge badge-danger">@Model.Status</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Payment Method:</th>
                                        <td>@Model.PaymentMethod</td>
                                    </tr>
                                    <tr>
                                        <th>Payment Status:</th>
                                        <td>
                                            <span class="badge @(Model.PaymentStatus switch
                                            {
                                                ECommerceWebsite.Models.PaymentStatus.Paid => "badge-success",
                                                ECommerceWebsite.Models.PaymentStatus.Pending => "badge-warning",
                                                ECommerceWebsite.Models.PaymentStatus.Failed => "badge-danger",
                                                ECommerceWebsite.Models.PaymentStatus.Refunded => "badge-secondary",
                                                _ => "badge-light"
                                            })">
                                                @Model.PaymentStatus
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Total Amount:</th>
                                        <td><strong>$@Model.TotalAmount.ToString("F2")</strong></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card card-outline card-primary">
                            <div class="card-header">
                                <h6 class="mb-0">Customer Information</h6>
                            </div>
                            <div class="card-body">
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <th width="30%">Name:</th>
                                        <td>@Model.User.FirstName @Model.User.LastName</td>
                                    </tr>
                                    <tr>
                                        <th>Email:</th>
                                        <td>@Model.User.Email</td>
                                    </tr>
                                    <tr>
                                        <th>Phone:</th>
                                        <td>@Model.User.PhoneNumber</td>
                                    </tr>
                                </table>
                                
                                <hr>
                                
                                <h6 class="text-primary">Shipping Address</h6>
                                <address class="mb-0">
                                    @Model.ShippingFirstName @Model.ShippingLastName<br>
                                    @Model.ShippingAddress<br>
                                    @Model.ShippingCity, @Model.ShippingPostalCode<br>
                                    Phone: @Model.ShippingPhone
                                </address>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Items -->
                <div class="card card-outline card-warning">
                    <div class="card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-box me-2"></i>Order Items (@Model.OrderItems.Count items)
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Unit Price</th>
                                        <th>Quantity</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.OrderItems)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                                    {
                                                        <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="img-thumbnail me-2" style="width: 30px; height: 30px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-light d-flex align-items-center justify-content-center me-2" style="width: 30px; height: 30px;">
                                                            <i class="fas fa-image text-muted"></i>
                                                        </div>
                                                    }
                                                    <small><strong>@item.Product.Name</strong></small>
                                                </div>
                                            </td>
                                            <td><small>$@item.UnitPrice.ToString("F2")</small></td>
                                            <td><small>@item.Quantity</small></td>
                                            <td><small><strong>$@item.TotalPrice.ToString("F2")</strong></small></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-warning">
                                        <th colspan="3" class="text-end">Total:</th>
                                        <th><strong>$@Model.TotalAmount.ToString("F2")</strong></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Notes -->
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="card card-outline card-secondary mt-3">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-sticky-note me-2"></i>Notes
                            </h6>
                        </div>
                        <div class="card-body">
                            <p class="mb-0">@Model.Notes</p>
                        </div>
                    </div>
                }

                <!-- Deletion Information -->
                <div class="alert alert-danger mt-4" role="alert">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>What will be deleted:</strong>
                    <ul class="mb-0 mt-2">
                        <li>Order record and all associated data</li>
                        <li>All order items (@Model.OrderItems.Count items)</li>
                        <li>Order history and tracking information</li>
                        <li>Any notes or comments associated with this order</li>
                    </ul>
                </div>

                @if (Model.Status != ECommerceWebsite.Models.OrderStatus.Cancelled)
                {
                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-times-circle me-2"></i>
                        <strong>Cannot Delete!</strong> Only cancelled orders can be deleted. 
                        This order has status: <strong>@Model.Status</strong>
                        <br><br>
                        <strong>To delete this order:</strong>
                        <ol class="mb-0">
                            <li>First change the order status to "Cancelled"</li>
                            <li>Then you can delete the order</li>
                        </ol>
                    </div>
                }
            </div>

            <div class="card-footer">
                <div class="d-flex justify-content-between">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to Details
                    </a>
                    <div>
                        <a asp-action="Index" class="btn btn-outline-secondary me-2">
                            <i class="fas fa-list me-1"></i>All Orders
                        </a>
                        @if (Model.Status == ECommerceWebsite.Models.OrderStatus.Cancelled)
                        {
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you absolutely sure you want to delete this order? This action cannot be undone and will permanently remove all order data.');">
                                <input asp-for="Id" type="hidden" />
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-trash me-1"></i>Yes, Delete Order
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="fas fa-edit me-1"></i>Cancel Order First
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
