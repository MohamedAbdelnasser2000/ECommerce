@model ECommerceWebsite.ViewModels.ShippingMethodViewModel

@{
    ViewData["Title"] = "تعديل طريقة الشحن";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">تعديل طريقة الشحن: @Model.Name</h4>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="Edit">
                        <div asp-validation-summary="All" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label">اسم طريقة الشحن *</label>
                                    <input asp-for="Name" class="form-control" placeholder="مثال: شحن عادي، شحن سريع" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Cost" class="form-label">تكلفة الشحن ($) *</label>
                                    <input asp-for="Cost" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                                    <span asp-validation-for="Cost" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="EstimatedDays" class="form-label">أيام التوصيل المتوقعة *</label>
                                    <input asp-for="EstimatedDays" class="form-control" type="number" min="1" max="30" placeholder="عدد الأيام" />
                                    <span asp-validation-for="EstimatedDays" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <div class="form-check form-switch">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActive">
                                        <label class="form-check-label" for="IsActive">
                                            نشط
                                        </label>
                                    </div>
                                    <span asp-validation-for="IsActive" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">الوصف</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="وصف طريقة الشحن (اختياري)"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> العودة للقائمة
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> حفظ التغييرات
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
