@model ECommerceWebsite.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-edit me-2"></i>Edit Product: @Model.Name
                </h3>
            </div>
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <input asp-for="Id" type="hidden" />

                    <div class="row">
                        <!-- Left Column -->
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Name" class="form-label">
                                    <i class="fas fa-tag me-1"></i>Product Name (English)
                                </label>
                                <input asp-for="Name" class="form-control" placeholder="Enter product name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="NameAr" class="form-label">
                                    <i class="fas fa-tag me-1"></i>اسم المنتج (العربية)
                                </label>
                                <input asp-for="NameAr" class="form-control" dir="rtl" placeholder="أدخل اسم المنتج" />
                                <span asp-validation-for="NameAr" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Description" class="form-label">
                                    <i class="fas fa-align-left me-1"></i>Description (English)
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter product description"></textarea>
                                <span asp-validation-for="Description" class":"text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="DescriptionAr" class="form-label">
                                    <i class="fas fa-align-left me-1"></i>الوصف (العربية)
                                </label>
                                <textarea asp-for="DescriptionAr" class="form-control" rows="4" dir="rtl" placeholder="أدخل وصف المنتج"></textarea>
                                <span asp-validation-for="DescriptionAr" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="CategoryId" class="form-label">
                                    <i class="fas fa-folder me-1"></i>Category
                                </label>
                                <select asp-for="CategoryId" class="form-control">
                                    <option value="">Select Category</option>
                                    @if (ViewBag.Categories != null)
                                    {
                                        @foreach (var category in ViewBag.Categories as IEnumerable<ECommerceWebsite.Models.Category>)
                                        {
                                            <option value="@category.Id">@category.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="ShortDescription" class="form-label">
                                    <i class="fas fa-align-center me-1"></i>Short Description (English)
                                </label>
                                <input asp-for="ShortDescription" class="form-control" placeholder="Brief highlight (optional)" />
                                <span asp-validation-for="ShortDescription" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="ShortDescriptionAr" class="form-label">
                                    <i class="fas fa-align-center me-1"></i>وصف مختصر (العربية)
                                </label>
                                <input asp-for="ShortDescriptionAr" class="form-control" dir="rtl" placeholder="أدخل وصفًا مختصرًا" />
                                <span asp-validation-for="ShortDescriptionAr" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label asp-for="Price" class="form-label">
                                            <i class="fas fa-dollar-sign me-1"></i>Price
                                        </label>
                                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                                        <span asp-validation-for="Price" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label asp-for="DiscountPrice" class="form-label">
                                            <i class="fas fa-percentage me-1"></i>Discount Price
                                        </label>
                                        <input asp-for="DiscountPrice" class="form-control" type="number" step="0.01" min="0" placeholder="0.00 (optional)" />
                                        <span asp-validation-for="DiscountPrice" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="StockQuantity" class="form-label">
                                    <i class="fas fa-boxes me-1"></i>Stock Quantity
                                </label>
                                <input asp-for="StockQuantity" class="form-control" type="number" min="0" placeholder="0" />
                                <span asp-validation-for="StockQuantity" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        <div class="form-check">
                                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                            <label asp-for="IsActive" class="form-check-label">
                                                <i class="fas fa-toggle-on me-1"></i>Active
                                            </label>
                                        </div>
                                        <div class="form-text">
                                            <i class="fas fa-info-circle me-1"></i>
                                            Only active products will be visible to customers.
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        <div class="form-check">
                                            <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                                            <label asp-for="IsFeatured" class="form-check-label">
                                                <i class="fas fa-star me-1"></i>Featured
                                            </label>
                                        </div>
                                        <div class="form-text">
                                            <i class="fas fa-info-circle me-1"></i>
                                            Featured products appear on the homepage.
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        <div class="form-check">
                                            <input asp-for="IsFeaturedInNewCarousel" class="form-check-input" type="checkbox" />
                                            <label asp-for="IsFeaturedInNewCarousel" class="form-check-label">
                                                <i class="fas fa-star me-1"></i>HomePage Carousel
                                            </label>
                                        </div>
                                        <div class="form-text">
                                            <i class="fas fa-info-circle me-1"></i>
                                            Featured products appear in the new homepage carousel.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="col-md-6">
                            <!-- Current Image Display -->
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="form-group mb-3">
                                    <label class="form-label">
                                        <i class="fas fa-image me-1"></i>Current Image
                                    </label>
                                    <div class="border rounded p-3 text-center">
                                        <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid" style="max-height: 250px;" />
                                    </div>
                                </div>
                            }

                            <div class="form-group mb-3">
                                <label for="imageFile" class="form-label">
                                    <i class="fas fa-upload me-1"></i>
                                    @(string.IsNullOrEmpty(Model.ImageUrl) ? "Product Image" : "Change Image")
                                </label>
                                <input type="file" name="imageFile" id="imageFile" class="form-control" accept="image/*" />
                                <div class="form-text">
                                    <i class="fas fa-info-circle me-1"></i>
                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <span>Leave empty to keep current image. </span>
                                    }
                                    Supported formats: JPG, PNG, GIF. Maximum size: 5MB.
                                </div>
                            </div>

                            <!-- New Image Preview -->
                            <div class="form-group mb-3" id="imagePreview" style="display: none;">
                                <label class="form-label">
                                    <i class="fas fa-eye me-1"></i>New Image Preview
                                </label>
                                <div class="border rounded p-3 text-center">
                                    <img id="previewImg" src="#" alt="Preview" class="img-fluid" style="max-height: 250px;" />
                                </div>
                            </div>

                            <!-- Additional Images Management -->
                            <div class="card card-outline card-secondary mt-3">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0">
                                        <i class="fas fa-images me-1"></i>Additional Images (max 6)
                                    </h6>
                                    <small class="text-muted">Currently: @((Model.ProductImages?.Count() ?? 0))</small>
                                </div>
                                <div class="card-body">
                                    @if (Model.ProductImages != null && Model.ProductImages.Any())
                                    {
                                        <div class="row g-2 mb-3">
                                            @foreach (var img in Model.ProductImages.Take(6))
                                            {
                                                <div class="col-4 col-md-3">
                                                    <div class="border rounded p-2 text-center position-relative">
                                                        <img src="@img.ImageUrl" class="img-fluid" style="max-height:120px; object-fit:cover; width:100%" />
                                                        <div class="form-check mt-2">
                                                            <input class="form-check-input" type="checkbox" name="deleteImageIds" value="@img.Id" id="del_@img.Id" />
                                                            <label class="form-check-label small" for="del_@img.Id">Delete</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <div class="mb-2">
                                        <label class="form-label">Upload New Images</label>
                                        <input type="file" name="additionalImages" class="form-control" accept="image/*" multiple />
                                        <small class="form-text text-muted">You can upload up to 6 images in total. Each file must be less than 5MB.</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Product Info Summary -->
                            <div class="card card-outline card-info">
                                <div class="card-header">
                                    <h6 class="mb-0">
                                        <i class="fas fa-info-circle me-1"></i>Product Information
                                    </h6>
                                </div>
                                <div class="card-body p-3">
                                    <table class="table table-sm table-borderless mb-0">
                                        <tr>
                                            <td><strong>Created:</strong></td>
                                            <td>@Model.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        </tr>
                                        @if (Model.UpdatedAt.HasValue)
                                        {
                                            <tr>
                                                <td><strong>Last Updated:</strong></td>
                                                <td>@Model.UpdatedAt.Value.ToString("MMM dd, yyyy")</td>
                                            </tr>
                                        }
                                        @if (Model.Category != null)
                                        {
                                            <tr>
                                                <td><strong>Current Category:</strong></td>
                                                <td>@Model.Category.Name</td>
                                            </tr>
                                        }
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Back to List
                        </a>
                        <div>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info me-2">
                                <i class="fas fa-eye me-1"></i>View Details
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>Update Product
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function() {
            // Image preview functionality
            $('#imageFile').change(function() {
                var file = this.files[0];
                if (file) {
                    // Validate file size (5MB)
                    if (file.size > 5 * 1024 * 1024) {
                        alert('File size must be less than 5MB');
                        $(this).val('');
                        $('#imagePreview').hide();
                        return;
                    }

                    // Validate file type
                    var validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
                    if (!validTypes.includes(file.type)) {
                        alert('Please select a valid image file (JPG, PNG, GIF)');
                        $(this).val('');
                        $('#imagePreview').hide();
                        return;
                    }

                    var reader = new FileReader();
                    reader.onload = function(e) {
                        $('#previewImg').attr('src', e.target.result);
                        $('#imagePreview').show();
                    }
                    reader.readAsDataURL(file);
                } else {
                    $('#imagePreview').hide();
                }
            });

            // Price validation
            $('#DiscountPrice').on('input', function() {
                var price = parseFloat($('#Price').val()) || 0;
                var discountPrice = parseFloat($(this).val()) || 0;

                if (discountPrice > 0 && discountPrice >= price) {
                    alert('Discount price must be less than the regular price');
                    $(this).focus();
                }
            });

            // Form validation
            $('form').submit(function(e) {
                var name = $('#Name').val().trim();
                var price = parseFloat($('#Price').val()) || 0;
                var stock = parseInt($('#StockQuantity').val()) || 0;
                var categoryId = $('#CategoryId').val();

                if (name === '') {
                    e.preventDefault();
                    alert('Product name is required');
                    $('#Name').focus();
                    return false;
                }

                if (price <= 0) {
                    e.preventDefault();
                    alert('Price must be greater than 0');
                    $('#Price').focus();
                    return false;
                }

                if (stock < 0) {
                    e.preventDefault();
                    alert('Stock quantity cannot be negative');
                    $('#StockQuantity').focus();
                    return false;
                }

                if (!categoryId) {
                    e.preventDefault();
                    alert('Please select a category');
                    $('#CategoryId').focus();
                    return false;
                }
            });
        });
    </script>
}
