@model IEnumerable<ECommerceWebsite.Models.Product>
@{
    ViewData["Title"] = "Products Management";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-box me-2"></i>Products Management
                </h3>
                <div class="card-tools">
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>Add New Product
                    </a>
                </div>
            </div>
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @TempData["Error"]
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success" role="alert">
                        @TempData["Success"]
                    </div>
                }
                <!-- Filters -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="input-group">
                            <input type="text" class="form-control" id="searchInput" placeholder="Search products...">
                            <button class="btn btn-outline-secondary" type="button">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="statusFilter">
                            <option value="">All Status</option>
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="stockFilter">
                            <option value="">All Stock</option>
                            <option value="low">Low Stock (≤10)</option>
                            <option value="out">Out of Stock</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-outline-primary w-100" id="resetFilters">
                            <i class="fas fa-undo me-1"></i>Reset
                        </button>
                    </div>
                </div>

                <!-- Products Table -->
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="productsTable">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th>Featured</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var product in Model)
                                {
                                    <tr data-product-id="@product.Id" data-stock="@product.StockQuantity">
                                        <td>
                                            <img src="@(product.ImageUrl ?? "/images/no-image.jpg")"
                                                 alt="@product.Name" class="rounded"
                                                 style="width: 50px; height: 50px; object-fit: cover;">
                                        </td>
                                        <td>
                                            <div>
                                                <strong>@product.Name</strong>
                                                @if (product.DiscountPrice.HasValue)
                                                {
                                                    <span class="badge bg-danger ms-1">Sale</span>
                                                }
                                                <br>
                                                <small class="text-muted">
                                                    @(product.Description.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description)
                                                </small>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">@product.Category.Name</span>
                                        </td>
                                        <td>
                                            @if (product.DiscountPrice.HasValue)
                                            {
                                                <div>
                                                    <span class="text-decoration-line-through text-muted">$@product.Price</span>
                                                    <br>
                                                    <strong class="text-success">$@product.DiscountPrice</strong>
                                                </div>
                                            }
                                            else
                                            {
                                                <strong>$@product.Price</strong>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-@(product.StockQuantity <= 0 ? "danger" : product.StockQuantity <= 5 ? "warning" : product.StockQuantity <= 10 ? "info" : "success")">
                                                @product.StockQuantity
                                            </span>
                                            @if (product.StockQuantity <= 5)
                                            {
                                                <br><small class="text-danger">@(product.StockQuantity <= 0 ? "Out of Stock!" : "Low Stock!")</small>
                                            }
                                        </td>
                                        <td>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input status-toggle" type="checkbox"
                                                       @(product.IsActive ? "checked" : "")
                                                       data-product-id="@product.Id">
                                                <label class="form-check-label">
                                                    @(product.IsActive ? "Active" : "Inactive")
                                                </label>
                                            </div>
                                        </td>
                                        <td>
                                            @if (product.IsFeatured)
                                            {
                                                <span class="badge bg-warning">
                                                    <i class="fas fa-star me-1"></i>Featured
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <span>@product.CreatedAt.ToString("MMM dd, yyyy")</span>
                                            <br>
                                            <small class="text-muted">@product.CreatedAt.ToString("HH:mm")</small>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a asp-action="Details" asp-route-id="@product.Id"
                                                   class="btn btn-outline-info" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@product.Id"
                                                   class="btn btn-outline-primary" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <button class="btn btn-outline-danger delete-product"
                                                        data-product-id="@product.Id"
                                                        data-product-name="@product.Name" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4">
                                        <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                                        <h5 class="text-muted">No products found</h5>
                                        <p class="text-muted">Start by adding your first product.</p>
                                        <a asp-action="Create" class="btn btn-primary">
                                            <i class="fas fa-plus me-1"></i>Add Product
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Summary -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div>
                        <small class="text-muted">
                            Showing @(Model?.Count() ?? 0) products
                        </small>
                    </div>
                    <div>
                        <span class="badge bg-success me-1">@(Model?.Count(p => p.IsActive) ?? 0) Active</span>
                        <span class="badge bg-secondary me-1">@(Model?.Count(p => !p.IsActive) ?? 0) Inactive</span>
                        <span class="badge bg-warning me-1">@(Model?.Count(p => p.StockQuantity <= 10) ?? 0) Low Stock</span>
                        <span class="badge bg-primary">@(Model?.Count(p => p.IsFeatured) ?? 0) Featured</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the product "<span id="productName"></span>"?</p>
                <p class="text-danger small">
                    <i class="fas fa-warning me-1"></i>This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>Delete Product
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            let currentProductId = null;

            // Search functionality
            $('#searchInput').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $('#productsTable tbody tr').filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            // Status filter
            $('#statusFilter').on('change', function() {
                var status = $(this).val();
                if (status === '') {
                    $('#productsTable tbody tr').show();
                } else {
                    $('#productsTable tbody tr').each(function() {
                        var isActive = $(this).find('.status-toggle').is(':checked');
                        var shouldShow = (status === 'true' && isActive) || (status === 'false' && !isActive);
                        $(this).toggle(shouldShow);
                    });
                }
            });

            // Stock filter
            $('#stockFilter').on('change', function() {
                var filter = $(this).val();
                if (filter === '') {
                    $('#productsTable tbody tr').show();
                } else {
                    $('#productsTable tbody tr').each(function() {
                        var stock = parseInt($(this).data('stock'));
                        var shouldShow = false;

                        if (filter === 'low' && stock <= 10 && stock > 0) {
                            shouldShow = true;
                        } else if (filter === 'out' && stock <= 0) {
                            shouldShow = true;
                        }

                        $(this).toggle(shouldShow);
                    });
                }
            });

            // Reset filters
            $('#resetFilters').on('click', function() {
                $('#searchInput').val('');
                $('#statusFilter').val('');
                $('#stockFilter').val('');
                $('#productsTable tbody tr').show();
            });

            // Status toggle
            $('.status-toggle').on('change', function() {
                var productId = $(this).data('product-id');
                var isActive = $(this).is(':checked');
                var toggle = $(this);
                var label = $(this).next('label');

                $.post('@Url.Action("ToggleStatus")', { id: productId })
                    .done(function(response) {
                        if (response.success) {
                            label.text(response.isActive ? 'Active' : 'Inactive');

                            // Show success message
                            showToast('Product status updated successfully!', 'success');
                        } else {
                            // Revert toggle if failed
                            toggle.prop('checked', !isActive);
                            showToast(response.message || 'Failed to update status', 'error');
                        }
                    })
                    .fail(function() {
                        // Revert toggle if failed
                        toggle.prop('checked', !isActive);
                        showToast('Error updating product status', 'error');
                    });
            });

            // Delete product
            $('.delete-product').on('click', function() {
                var productId = $(this).data('product-id');
                var productName = $(this).data('product-name');
                $('#productName').text(productName);
                $('#deleteForm').attr('action', '@Url.Action("Delete")/' + productId);
                $('#deleteModal').modal('show');
            });

            // Add hover effects
            $('#productsTable tbody tr').hover(
                function() {
                    $(this).addClass('table-active');
                },
                function() {
                    $(this).removeClass('table-active');
                }
            );
        });

        function showToast(message, type) {
            // Simple toast notification
            var toast = $('<div class="alert alert-' + (type === 'success' ? 'success' : 'danger') + ' alert-dismissible fade show position-fixed" style="top: 20px; right: 20px; z-index: 9999;">' +
                '<i class="fas fa-' + (type === 'success' ? 'check-circle' : 'exclamation-circle') + ' me-2"></i>' + message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                '</div>');

            $('body').append(toast);

            setTimeout(function() {
                toast.alert('close');
            }, 5000);
        }
    </script>
}
