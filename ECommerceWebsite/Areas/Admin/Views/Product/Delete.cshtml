@model ECommerceWebsite.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>Delete Product
                </h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Warning!</strong> Are you sure you want to delete this product? This action cannot be undone.
                </div>

                <div class="row">
                    <!-- Product Image -->
                    <div class="col-md-4 text-center mb-3">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded shadow" style="max-height: 250px;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center rounded shadow" style="height: 200px;">
                                <i class="fas fa-image fa-3x text-muted"></i>
                            </div>
                        }
                    </div>

                    <!-- Product Information -->
                    <div class="col-md-8">
                        <table class="table table-borderless">
                            <tr>
                                <th width="30%">
                                    <i class="fas fa-tag me-2 text-primary"></i>Name:
                                </th>
                                <td>
                                    <strong>@Model.Name</strong>
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-align-left me-2 text-primary"></i>Description:
                                </th>
                                <td>
                                    @if (Model.Description.Length > 100)
                                    {
                                        @(Model.Description.Substring(0, 100) + "...")
                                    }
                                    else
                                    {
                                        @Model.Description
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-folder me-2 text-primary"></i>Category:
                                </th>
                                <td>
                                    <span class="badge badge-info">@Model.Category.Name</span>
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-dollar-sign me-2 text-primary"></i>Price:
                                </th>
                                <td>
                                    @if (Model.DiscountPrice.HasValue)
                                    {
                                        <span class="text-muted text-decoration-line-through me-2">$@Model.Price</span>
                                        <strong class="text-success">$@Model.DiscountPrice</strong>
                                    }
                                    else
                                    {
                                        <strong>$@Model.Price</strong>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-boxes me-2 text-primary"></i>Stock:
                                </th>
                                <td>
                                    <span class="badge @(Model.StockQuantity > 10 ? "badge-success" : Model.StockQuantity > 0 ? "badge-warning" : "badge-danger")">
                                        @Model.StockQuantity units
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-toggle-on me-2 text-primary"></i>Status:
                                </th>
                                <td>
                                    <span class="badge @(Model.IsActive ? "badge-success" : "badge-secondary")">
                                        @(Model.IsActive ? "Active" : "Inactive")
                                    </span>
                                    @if (Model.IsFeatured)
                                    {
                                        <span class="badge badge-warning ms-1">Featured</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-calendar me-2 text-primary"></i>Created:
                                </th>
                                <td>
                                    @Model.CreatedAt.ToString("MMMM dd, yyyy")
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Additional Information -->
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="alert alert-info" role="alert">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>What will be deleted:</strong>
                            <ul class="mb-0 mt-2">
                                <li>Product information and details</li>
                                <li>Product image (if uploaded)</li>
                                @if (Model.Reviews.Any())
                                {
                                    <li><strong>@Model.Reviews.Count customer review(s)</strong></li>
                                }
                                @if (Model.CartItems.Any())
                                {
                                    <li><strong>Items in customer shopping carts</strong></li>
                                }
                                @if (Model.WishlistItems.Any())
                                {
                                    <li><strong>Items in customer wishlists</strong></li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Warnings for related data -->
                @if (Model.Reviews.Any() || Model.CartItems.Any() || Model.WishlistItems.Any())
                {
                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Important:</strong> This product has related data that will also be affected:
                        <ul class="mb-0 mt-2">
                            @if (Model.Reviews.Any())
                            {
                                <li><strong>@Model.Reviews.Count customer review(s)</strong> will be permanently deleted</li>
                            }
                            @if (Model.CartItems.Any())
                            {
                                <li>Product will be <strong>removed from customer shopping carts</strong></li>
                            }
                            @if (Model.WishlistItems.Any())
                            {
                                <li>Product will be <strong>removed from customer wishlists</strong></li>
                            }
                        </ul>
                    </div>
                }

                <!-- Order History Warning -->
                @if (Model.OrderItems.Any())
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="fas fa-times-circle me-2"></i>
                        <strong>Cannot Delete!</strong> This product has been ordered by customers and cannot be deleted to maintain order history integrity.
                        <br><br>
                        <strong>Alternative actions:</strong>
                        <ul class="mb-0">
                            <li>Set the product as <strong>Inactive</strong> to hide it from customers</li>
                            <li>Set stock quantity to <strong>0</strong> to prevent new orders</li>
                            <li>Remove it from <strong>Featured</strong> products</li>
                        </ul>
                    </div>
                }
            </div>

            <div class="card-footer">
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to List
                    </a>
                    <div>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info me-2">
                            <i class="fas fa-eye me-1"></i>View Details
                        </a>
                        @if (!Model.OrderItems.Any())
                        {
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you absolutely sure you want to delete this product? This action cannot be undone and will remove all related data including reviews and cart items.');">
                                <input asp-for="Id" type="hidden" />
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-trash me-1"></i>Yes, Delete Product
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="fas fa-edit me-1"></i>Edit Instead
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
