@model ECommerceWebsite.Models.Product
@{
    ViewData["Title"] = "Add New Product";
    var categories = ViewBag.Categories as IEnumerable<ECommerceWebsite.Models.Category>;
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-plus me-2"></i>Add New Product
                </h3>
            </div>
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="card-body">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
                        </div>
                    }

                    @if (TempData["DebugErrors"] != null)
                    {
                        <div class="alert alert-warning">
                            <strong>Debug Info:</strong> @TempData["DebugErrors"]
                        </div>
                    }

                    @if (ViewBag.DebugCategoriesCount != null)
                    {
                        <div class="alert alert-info">
                            <strong>Debug:</strong> @ViewBag.DebugCategoriesCount categories loaded, CategoryId: @(ViewBag.DebugCategoryId ?? "null")
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label">Product Name (English) *</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter product name" required>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="NameAr" class="form-label">اسم المنتج (العربية)</label>
                            <input asp-for="NameAr" class="form-control" dir="rtl" placeholder="أدخل اسم المنتج">
                            <span asp-validation-for="NameAr" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId" class="form-label">Category *</label>
                            <select asp-for="CategoryId" class="form-select" required>
                                <option value="">Select Category</option>
                                @if (ViewBag.Categories != null && ((IEnumerable<dynamic>)ViewBag.Categories).Any())
                                {
                                    @foreach (var category in ViewBag.Categories)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                }
                                else
                                {
                                    <option value="" disabled>No categories available</option>
                                }
                            </select>
                            @if (ViewBag.DebugCategoriesCount != null)
                            {
                                <small class="form-text text-muted">Debug: @ViewBag.DebugCategoriesCount categories loaded</small>
                            }
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ShortDescription" class="form-label">Short Description</label>
                            <input asp-for="ShortDescription" class="form-control" placeholder="Brief highlight (optional)">
                            <span asp-validation-for="ShortDescription" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Description" class="form-label">Description (English) *</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter product description" required></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="DescriptionAr" class="form-label">الوصف (العربية)</label>
                            <textarea asp-for="DescriptionAr" class="form-control" rows="4" dir="rtl" placeholder="أدخل وصف المنتج"></textarea>
                            <span asp-validation-for="DescriptionAr" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Price" class="form-label">Price ($) *</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" required>
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="DiscountPrice" class="form-label">Discount Price ($)</label>
                            <input asp-for="DiscountPrice" class="form-control" type="number" step="0.01" min="0" placeholder="0.00">
                            <span asp-validation-for="DiscountPrice" class="text-danger"></span>
                            <small class="form-text text-muted">Leave empty if no discount</small>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ShortDescriptionAr" class="form-label">وصف مختصر (العربية)</label>
                            <input asp-for="ShortDescriptionAr" class="form-control" dir="rtl" placeholder="أدخل وصفًا مختصرًا">
                            <span asp-validation-for="ShortDescriptionAr" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StockQuantity" class="form-label">Stock Quantity *</label>
                            <input asp-for="StockQuantity" class="form-control" type="number" min="0" placeholder="0" required>
                            <span asp-validation-for="StockQuantity" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Product Image (Main)</label>
                            <input type="file" name="imageFile" class="form-control" accept="image/*" id="imageInput">
                            <small class="form-text text-muted">Supported formats: JPG, PNG, GIF (Max: 5MB)</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Additional Images (up to 6)</label>
                        <input type="file" name="additionalImages" class="form-control" accept="image/*" multiple>
                        <small class="form-text text-muted">You can select up to 6 extra images. Each file must be less than 5MB.</small>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" checked>
                                <label asp-for="IsActive" class="form-check-label">Active Product</label>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsFeatured" class="form-check-input">
                                <label asp-for="IsFeatured" class="form-check-label">Featured Product</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Save Product
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-times me-1"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-4">
        <!-- Image Preview -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="fas fa-image me-2"></i>Image Preview
                </h5>
            </div>
            <div class="card-body text-center">
                <img id="imagePreview" src="/images/no-image.jpg" alt="Product Preview"
                     class="img-fluid rounded" style="max-height: 300px; width: 100%; object-fit: cover;">
            </div>
        </div>

        <!-- Tips -->
        <div class="card mt-3">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="fas fa-lightbulb me-2"></i>Tips
                </h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        Use high-quality images for better sales
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        Write detailed product descriptions
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        Set competitive pricing
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        Keep stock quantities updated
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        Use featured products for promotions
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function() {
            // Image preview
            $('#imageInput').on('change', function(e) {
                var file = e.target.files[0];
                if (file) {
                    // Validate file size (5MB)
                    if (file.size > 5 * 1024 * 1024) {
                        alert('File size must be less than 5MB');
                        $(this).val('');
                        return;
                    }

                    // Validate file type
                    if (!file.type.match('image.*')) {
                        alert('Please select a valid image file');
                        $(this).val('');
                        return;
                    }

                    var reader = new FileReader();
                    reader.onload = function(e) {
                        $('#imagePreview').attr('src', e.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Price validation
            $('#Price').on('input', function() {
                var price = parseFloat($(this).val());
                var discountPrice = parseFloat($('#DiscountPrice').val());

                if (discountPrice && discountPrice >= price) {
                    $('#DiscountPrice').addClass('is-invalid');
                    $('#DiscountPrice').next('.text-danger').remove();
                    $('#DiscountPrice').after('<span class="text-danger">Discount price must be less than regular price</span>');
                } else {
                    $('#DiscountPrice').removeClass('is-invalid');
                    $('#DiscountPrice').next('.text-danger').remove();
                }
            });

            $('#DiscountPrice').on('input', function() {
                var price = parseFloat($('#Price').val());
                var discountPrice = parseFloat($(this).val());

                if (discountPrice && discountPrice >= price) {
                    $(this).addClass('is-invalid');
                    $(this).next('.text-danger').remove();
                    $(this).after('<span class="text-danger">Discount price must be less than regular price</span>');
                } else {
                    $(this).removeClass('is-invalid');
                    $(this).next('.text-danger').remove();
                }
            });

            // Form validation
            $('form').on('submit', function(e) {
                var isValid = true;
                var errorMessages = [];

                // Check required fields
                $('input[required], select[required], textarea[required]').each(function() {
                    if (!$(this).val() || $(this).val() === '') {
                        $(this).addClass('is-invalid');
                        isValid = false;
                        var fieldName = $(this).attr('name') || $(this).attr('id') || 'Field';
                        errorMessages.push(fieldName + ' is required');
                    } else {
                        $(this).removeClass('is-invalid');
                    }
                });

                // Check price validation
                var price = parseFloat($('#Price').val());
                var discountPrice = parseFloat($('#DiscountPrice').val());

                if (discountPrice && discountPrice >= price) {
                    isValid = false;
                    errorMessages.push('Discount price must be less than regular price');
                }

                if (!isValid) {
                    e.preventDefault();
                    showToast('Please fix the following errors: ' + errorMessages.join(', '), 'error');
                }
            });

            // Auto-generate slug from name (for future use)
            $('#Name').on('input', function() {
                var name = $(this).val();
                // You can add slug generation logic here if needed
            });
        });

        function showToast(message, type) {
            var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            var iconClass = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';

            var toast = $('<div class="alert ' + alertClass + ' alert-dismissible fade show position-fixed" style="top: 20px; right: 20px; z-index: 9999;">' +
                '<i class="fas ' + iconClass + ' me-2"></i>' + message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                '</div>');

            $('body').append(toast);

            setTimeout(function() {
                toast.remove();
            }, 5000);
        }
    </script>
}
