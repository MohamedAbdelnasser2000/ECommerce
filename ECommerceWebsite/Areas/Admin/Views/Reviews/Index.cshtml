@model IEnumerable<ECommerceWebsite.Models.Review>

@{
    ViewData["Title"] = "Reviews Management";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-star me-2"></i>Reviews Management
                </h3>
                <div class="card-tools">
                    <span class="badge badge-info">
                        Total: @ViewBag.TotalReviews reviews
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>@ViewBag.TotalApproved</h3>
                <p>Approved Reviews</p>
            </div>
            <div class="icon">
                <i class="fas fa-check-circle"></i>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3>@ViewBag.TotalPending</h3>
                <p>Pending Reviews</p>
            </div>
            <div class="icon">
                <i class="fas fa-clock"></i>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>@ViewBag.AverageRating.ToString("F1")</h3>
                <p>Average Rating</p>
            </div>
            <div class="icon">
                <i class="fas fa-star"></i>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-primary">
            <div class="inner">
                <h3>@ViewBag.TotalReviews</h3>
                <p>Total Reviews</p>
            </div>
            <div class="icon">
                <i class="fas fa-comments"></i>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <!-- Filters -->
            <div class="card-body border-bottom">
                <form method="get" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Status Filter</label>
                        <select name="status" class="form-control">
                            <option value="">All Reviews</option>
                            <option value="approved" selected="@(ViewBag.CurrentStatus == "approved")">Approved</option>
                            <option value="pending" selected="@(ViewBag.CurrentStatus == "pending")">Pending</option>
                            <option value="high" selected="@(ViewBag.CurrentStatus == "high")">High Rating (4-5)</option>
                            <option value="low" selected="@(ViewBag.CurrentStatus == "low")">Low Rating (1-2)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Search</label>
                        <input type="text" name="search" class="form-control" placeholder="Product name, customer name, comment..." value="@ViewBag.CurrentSearch" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search me-1"></i>Filter
                            </button>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Bulk Actions</label>
                        <div class="input-group">
                            <select id="bulkAction" class="form-control">
                                <option value="">Select Action</option>
                                <option value="approve">Approve Selected</option>
                                <option value="reject">Reject Selected</option>
                                <option value="delete">Delete Selected</option>
                            </select>
                            <button type="button" id="applyBulkAction" class="btn btn-warning">Apply</button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="card-body">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th width="40">
                                        <input type="checkbox" id="selectAll" />
                                    </th>
                                    <th>Product</th>
                                    <th>Customer</th>
                                    <th>Rating</th>
                                    <th>Comment</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var review in Model)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="review-checkbox" value="@review.Id" />
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(review.Product.ImageUrl))
                                                {
                                                    <img src="@review.Product.ImageUrl" alt="@review.Product.Name" class="img-thumbnail me-2" style="width: 40px; height: 40px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-light d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                                                        <i class="fas fa-image text-muted"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <strong>@review.Product.Name</strong>
                                                    <br>
                                                    <small class="text-muted">ID: @review.Product.Id</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div>
                                                <strong>@review.User.FirstName @review.User.LastName</strong>
                                                <br>
                                                <small class="text-muted">@review.User.Email</small>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="rating">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= review.Rating)
                                                    {
                                                        <i class="fas fa-star text-warning"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="far fa-star text-muted"></i>
                                                    }
                                                }
                                                <br>
                                                <small class="text-muted">(@review.Rating/5)</small>
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(review.Comment))
                                            {
                                                <div class="comment-preview">
                                                    @if (review.Comment.Length > 100)
                                                    {
                                                        <span>@review.Comment.Substring(0, 100)...</span>
                                                        <br>
                                                        <small><a asp-action="Details" asp-route-id="@review.Id">Read more</a></small>
                                                    }
                                                    else
                                                    {
                                                        <span>@review.Comment</span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <em class="text-muted">No comment</em>
                                            }
                                        </td>
                                        <td>
                                            <span>@review.CreatedAt.ToString("MMM dd, yyyy")</span>
                                            <br>
                                            <small class="text-muted">@review.CreatedAt.ToString("HH:mm")</small>
                                        </td>
                                        <td>
                                            @if (review.IsApproved)
                                            {
                                                <span class="badge badge-success">Approved</span>
                                                @if (review.ApprovedAt.HasValue)
                                                {
                                                    <br><small class="text-muted">@review.ApprovedAt.Value.ToString("MMM dd")</small>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning">Pending</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@review.Id" class="btn btn-info btn-sm" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                @if (!review.IsApproved)
                                                {
                                                    <button type="button" class="btn btn-success btn-sm quick-approve" data-id="@review.Id" title="Approve">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-warning btn-sm quick-reject" data-id="@review.Id" title="Reject">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                }
                                                <a asp-action="Delete" asp-route-id="@review.Id" class="btn btn-danger btn-sm" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (ViewBag.TotalPages > 1)
                    {
                        <nav aria-label="Reviews pagination">
                            <ul class="pagination justify-content-center">
                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="?page=@i&status=@ViewBag.CurrentStatus&search=@ViewBag.CurrentSearch">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-star fa-3x text-muted mb-3"></i>
                        <h4 class="text-muted">No Reviews Found</h4>
                        <p class="text-muted">No reviews match your current filters.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Select all checkbox
            $('#selectAll').change(function() {
                $('.review-checkbox').prop('checked', $(this).prop('checked'));
            });

            // Quick approve
            $('.quick-approve').click(function() {
                var reviewId = $(this).data('id');
                
                if (confirm('Are you sure you want to approve this review?')) {
                    $.post('@Url.Action("QuickApprove")', {
                        id: reviewId
                    }, function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    });
                }
            });

            // Quick reject
            $('.quick-reject').click(function() {
                var reviewId = $(this).data('id');
                
                if (confirm('Are you sure you want to reject this review?')) {
                    $.post('@Url.Action("QuickReject")', {
                        id: reviewId
                    }, function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    });
                }
            });

            // Bulk actions
            $('#applyBulkAction').click(function() {
                var action = $('#bulkAction').val();
                var selectedReviews = $('.review-checkbox:checked').map(function() {
                    return $(this).val();
                }).get();

                if (!action) {
                    alert('Please select an action');
                    return;
                }

                if (selectedReviews.length === 0) {
                    alert('Please select at least one review');
                    return;
                }

                var actionText = action === 'approve' ? 'approve' : action === 'reject' ? 'reject' : 'delete';
                
                if (confirm('Are you sure you want to ' + actionText + ' ' + selectedReviews.length + ' review(s)?')) {
                    var url = '';
                    switch(action) {
                        case 'approve':
                            url = '@Url.Action("BulkApprove")';
                            break;
                        case 'reject':
                            url = '@Url.Action("BulkReject")';
                            break;
                        case 'delete':
                            url = '@Url.Action("BulkDelete")';
                            break;
                    }

                    $.post(url, {
                        reviewIds: selectedReviews
                    }, function(response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    });
                }
            });
        });
    </script>
}
