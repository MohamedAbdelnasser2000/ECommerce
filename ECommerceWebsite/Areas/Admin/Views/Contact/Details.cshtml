@model ECommerceWebsite.Models.ContactMessage
@{
    ViewData["Title"] = "Message Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="fas fa-envelope-open me-2"></i>Message Details</h2>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left"></i> Back</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (!Model.IsRead)
                {
                    <span class="badge bg-warning">Unread</span>
                }
                else
                {
                    <span class="badge bg-secondary">Read</span>
                }
            </dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9"><a href="mailto:@Model.Email">@Model.Email</a></dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.Phone</dd>

            <dt class="col-sm-3">Subject</dt>
            <dd class="col-sm-9">@Model.Subject</dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">IP Address</dt>
            <dd class="col-sm-9">@Model.IpAddress</dd>

            <dt class="col-sm-3">User Agent</dt>
            <dd class="col-sm-9">@Model.UserAgent</dd>

            <dt class="col-sm-3">Consent</dt>
            <dd class="col-sm-9">@(Model.Consent ? "Yes" : "No")</dd>

            <dt class="col-sm-3">Message</dt>
            <dd class="col-sm-9"><pre class="mb-0" style="white-space:pre-wrap">@Model.Message</pre></dd>
        </dl>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <div>
            @if (!Model.IsRead)
            {
                <form asp-action="MarkRead" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-success" type="submit"><i class="fas fa-check"></i> Mark as Read</button>
                </form>
            }
        </div>
        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this message?');">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-danger">
                <i class="fas fa-trash"></i> Delete
            </button>
        </form>
    </div>
</div>
