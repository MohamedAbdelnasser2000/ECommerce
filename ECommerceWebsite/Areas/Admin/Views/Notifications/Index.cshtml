@{
    ViewData["Title"] = "Admin Notifications";
    Layout = "../Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-bell me-2"></i>Admin Notifications</h5>
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="markAllNotificationsAsReadPage();">
                            <i class="far fa-check-circle me-1"></i> Mark all as read
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div id="page-notification-list" class="list-group list-group-flush">
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-spinner fa-spin"></i> Loading...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function renderPageNotificationItem(n) {
            var iconClass = n.icon && n.icon.length ? n.icon : 'fas fa-bell';
            var href = n.actionUrl && n.actionUrl.length ? n.actionUrl : '#';
            var extra = n.isRead ? '' : ' active';
            return (
                '<a href="' + href + '" class="list-group-item list-group-item-action' + extra + '" style="padding: 1rem 1.25rem;">' +
                '  <div class="d-flex w-100 align-items-start">' +
                '    <div class="me-3"><i class="' + iconClass + '" style="font-size:1.2rem;"></i></div>' +
                '    <div class="flex-grow-1">' +
                '      <div class="d-flex w-100 justify-content-between">' +
                '        <h6 class="mb-1">' + (n.title || '') + '</h6>' +
                '        <small class="text-muted">' + (n.type || '') + '</small>' +
                '      </div>' +
                '      <p class="mb-1 text-muted" style="white-space: normal;">' + (n.message || '') + '</p>' +
                '    </div>' +
                '  </div>' +
                '</a>'
            );
        }

        function loadPageNotifications() {
            var $list = $('#page-notification-list');
            $.get('/api/notification')
                .done(function (data) {
                    $list.empty();
                    if (Array.isArray(data) && data.length) {
                        var unread = 0;
                        data.forEach(function (n) {
                            if (!n.isRead) unread++;
                            $list.append(renderPageNotificationItem(n));
                        });
                        if (typeof updateNotificationCount === 'function') {
                            updateNotificationCount(unread);
                        }
                    } else {
                        $list.append('<div class="text-center text-muted py-5"><i class="fas fa-bell-slash mb-2"></i><br/>No notifications</div>');
                        if (typeof updateNotificationCount === 'function') {
                            updateNotificationCount(0);
                        }
                    }
                })
                .fail(function (xhr) {
                    if (xhr && xhr.status === 401) {
                        window.location = '/Account/Login';
                    } else {
                        $('#page-notification-list').html('<div class="text-center text-danger py-4">Failed to load notifications</div>');
                    }
                });
        }

        function getRequestVerificationToken() {
            var el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : null;
        }

        function markAllNotificationsAsReadPage() {
            var token = getRequestVerificationToken();
            $.ajax({
                url: '/api/notification/mark-all-read',
                method: 'POST',
                headers: token ? { 'RequestVerificationToken': token } : {},
            })
            .done(function () {
                if (typeof updateNotificationCount === 'function') {
                    updateNotificationCount(0);
                }
                loadPageNotifications();
                if (window.toastr) toastr.success('All notifications marked as read', 'Success');
            })
            .fail(function () {
                if (window.toastr) toastr.error('Failed to mark notifications as read', 'Error');
            });
        }

        $(document).ready(function () {
            loadPageNotifications();
        });
    </script>
}


