@model ECommerceWebsite.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-info-circle me-2"></i>Category Details
                </h3>
                <div class="card-tools">
                    <span class="badge @(Model.IsActive ? "badge-success" : "badge-secondary")">
                        <i class="fas @(Model.IsActive ? "fa-check" : "fa-times") me-1"></i>
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Category Image -->
                    <div class="col-md-4 text-center mb-3">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded shadow" style="max-height: 300px;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center rounded shadow" style="height: 200px;">
                                <i class="fas fa-image fa-3x text-muted"></i>
                            </div>
                            <p class="text-muted mt-2">No image available</p>
                        }
                    </div>
                    
                    <!-- Category Information -->
                    <div class="col-md-8">
                        <table class="table table-borderless">
                            <tr>
                                <th width="30%">
                                    <i class="fas fa-tag me-2 text-primary"></i>Name:
                                </th>
                                <td>
                                    <strong>@Model.Name</strong>
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-align-left me-2 text-primary"></i>Description:
                                </th>
                                <td>
                                    @if (!string.IsNullOrEmpty(Model.Description))
                                    {
                                        @Model.Description
                                    }
                                    else
                                    {
                                        <span class="text-muted">No description provided</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-toggle-on me-2 text-primary"></i>Status:
                                </th>
                                <td>
                                    <span class="badge @(Model.IsActive ? "badge-success" : "badge-secondary")">
                                        <i class="fas @(Model.IsActive ? "fa-check" : "fa-times") me-1"></i>
                                        @(Model.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-box me-2 text-primary"></i>Products:
                                </th>
                                <td>
                                    <span class="badge badge-info">@Model.Products.Count products</span>
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-calendar me-2 text-primary"></i>Created:
                                </th>
                                <td>
                                    @Model.CreatedAt.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            
            <!-- Products in this Category -->
            @if (Model.Products.Any())
            {
                <div class="card-footer">
                    <h5 class="mb-3">
                        <i class="fas fa-box me-2"></i>Products in this Category (@Model.Products.Count)
                    </h5>
                    <div class="row">
                        @foreach (var product in Model.Products.Take(6))
                        {
                            <div class="col-md-4 col-sm-6 mb-3">
                                <div class="card card-outline card-info">
                                    <div class="card-body p-2">
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                                            {
                                                <img src="@product.ImageUrl" alt="@product.Name" class="img-thumbnail me-2" style="width: 40px; height: 40px; object-fit: cover;">
                                            }
                                            else
                                            {
                                                <div class="bg-light d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                                                    <i class="fas fa-image text-muted"></i>
                                                </div>
                                            }
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">@product.Name</h6>
                                                <small class="text-muted">$@product.FinalPrice</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    @if (Model.Products.Count > 6)
                    {
                        <div class="text-center">
                            <small class="text-muted">And @(Model.Products.Count - 6) more products...</small>
                        </div>
                    }
                </div>
            }
            
            <!-- Action Buttons -->
            <div class="card-footer">
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to List
                    </a>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                            <i class="fas fa-edit me-1"></i>Edit
                        </a>
                        @if (!Model.Products.Any())
                        {
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                                <i class="fas fa-trash me-1"></i>Delete
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-danger" disabled title="Cannot delete category with products">
                                <i class="fas fa-trash me-1"></i>Delete
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
