@model ECommerceWebsite.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>Delete Category
                </h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Warning!</strong> Are you sure you want to delete this category? This action cannot be undone.
                </div>

                <div class="row">
                    <!-- Category Image -->
                    <div class="col-md-4 text-center mb-3">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded shadow" style="max-height: 200px;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center rounded shadow" style="height: 150px;">
                                <i class="fas fa-image fa-3x text-muted"></i>
                            </div>
                        }
                    </div>
                    
                    <!-- Category Information -->
                    <div class="col-md-8">
                        <table class="table table-borderless">
                            <tr>
                                <th width="30%">
                                    <i class="fas fa-tag me-2 text-primary"></i>Name:
                                </th>
                                <td>
                                    <strong>@Model.Name</strong>
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-align-left me-2 text-primary"></i>Description:
                                </th>
                                <td>
                                    @if (!string.IsNullOrEmpty(Model.Description))
                                    {
                                        @Model.Description
                                    }
                                    else
                                    {
                                        <span class="text-muted">No description</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-toggle-on me-2 text-primary"></i>Status:
                                </th>
                                <td>
                                    <span class="badge @(Model.IsActive ? "badge-success" : "badge-secondary")">
                                        @(Model.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-box me-2 text-primary"></i>Products:
                                </th>
                                <td>
                                    <span class="badge badge-info">@Model.Products.Count products</span>
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-calendar me-2 text-primary"></i>Created:
                                </th>
                                <td>
                                    @Model.CreatedAt.ToString("MMMM dd, yyyy")
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Products Warning -->
                @if (Model.Products.Any())
                {
                    <div class="alert alert-danger mt-3" role="alert">
                        <i class="fas fa-times-circle me-2"></i>
                        <strong>Cannot Delete!</strong> This category contains <strong>@Model.Products.Count product(s)</strong>. 
                        You must remove or reassign all products before deleting this category.
                    </div>
                    
                    <div class="mt-3">
                        <h6><i class="fas fa-box me-2"></i>Products in this category:</h6>
                        <div class="row">
                            @foreach (var product in Model.Products.Take(6))
                            {
                                <div class="col-md-6 mb-2">
                                    <div class="card card-outline card-warning">
                                        <div class="card-body p-2">
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                                {
                                                    <img src="@product.ImageUrl" alt="@product.Name" class="img-thumbnail me-2" style="width: 30px; height: 30px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-light d-flex align-items-center justify-content-center me-2" style="width: 30px; height: 30px;">
                                                        <i class="fas fa-image text-muted"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <small><strong>@product.Name</strong></small><br>
                                                    <small class="text-muted">$@product.FinalPrice</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (Model.Products.Count > 6)
                        {
                            <small class="text-muted">And @(Model.Products.Count - 6) more products...</small>
                        }
                    </div>
                }
            </div>

            <div class="card-footer">
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to List
                    </a>
                    <div>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info me-2">
                            <i class="fas fa-eye me-1"></i>View Details
                        </a>
                        @if (!Model.Products.Any())
                        {
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you absolutely sure you want to delete this category? This action cannot be undone.');">
                                <input asp-for="Id" type="hidden" />
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-trash me-1"></i>Yes, Delete Category
                                </button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn btn-danger" disabled title="Cannot delete category with products">
                                <i class="fas fa-trash me-1"></i>Cannot Delete
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
